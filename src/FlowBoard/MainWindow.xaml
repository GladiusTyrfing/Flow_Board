<ui:FluentWindow x:Class="FlowBoard.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FlowBoard.ViewModels"
                 xmlns:models="clr-namespace:FlowBoard.Models"
                 xmlns:views="clr-namespace:FlowBoard.Views"
                 xmlns:h="clr-namespace:FlowBoard.Helpers"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="FlowBoard"
                 Width="1400" Height="860" MinWidth="880" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenFilterCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding QuickAddCardCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewBoardCommand}" />
        <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding StartAddListCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding DoUndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding DoRedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding DoRedoCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:BoardViewMode.Board}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:BoardViewMode.Table}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:BoardViewMode.Calendar}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding TogglePomodoroCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenShortcutsCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveNowCommand}" />
        <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding OpenArchiveCommand}" />
        <KeyBinding Key="Space" Modifiers="Control+Shift" Command="{Binding OpenQuickAddCommand}" />
        <KeyBinding Key="F2" Command="{Binding StartRenameBoardCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseTopDialogCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/DialogTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Board entry in the sidebar -->
            <DataTemplate x:Key="SidebarBoardTemplate" DataType="{x:Type models:Board}">
                <Button x:Name="Btn" Style="{StaticResource Fb.GhostButton}" Padding="8,6" Margin="0,1"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenBoardCommand}"
                        CommandParameter="{Binding}" ToolTip="{Binding Name}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenBoardCommand}" CommandParameter="{Binding}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Star / unstar" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleStarCommand}" CommandParameter="{Binding}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Star24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Duplicate" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DuplicateBoardCommand}" CommandParameter="{Binding}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Delete board…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteBoardCommand}" CommandParameter="{Binding}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="20" CornerRadius="4" HorizontalAlignment="Left"
                                Background="{Binding Background, Converter={StaticResource BoardThumbnail}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fb.TextBrush}" FontSize="14" />
                        <Button x:Name="Star" Grid.Column="2" Style="{StaticResource Fb.IconButton}" Width="24" Height="24" Visibility="Hidden"
                                Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleStarCommand}" CommandParameter="{Binding}"
                                ToolTip="Star board">
                            <ui:SymbolIcon x:Name="StarIcon" Symbol="Star24" FontSize="14" />
                        </Button>
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource Same}">
                                <Binding />
                                <Binding Source="{x:Static vm:MainViewModel.Instance}" Path="CurrentBoard" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter TargetName="Btn" Property="Background" Value="{DynamicResource Fb.SidebarItemSelectedBrush}" />
                    </DataTrigger>
                    <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsStarred}" Value="True">
                        <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                        <Setter TargetName="StarIcon" Property="Filled" Value="True" />
                        <Setter TargetName="StarIcon" Property="Foreground" Value="#F5CD47" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Title bar ================= -->
        <ui:TitleBar Grid.Row="0" Title="FlowBoard" Height="44">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>

            <ui:TitleBar.CenterContent>
                <Button Width="440" Height="30" Cursor="IBeam" Command="{Binding OpenCommandPaletteCommand}" ToolTip="Search (Ctrl+K)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Background="{DynamicResource Fb.SubtleBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource Fb.DividerBrush}" Padding="10,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                        <TextBlock Margin="8,0,0,0" Text="Search cards, boards and commands" FontSize="13"
                                                   Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="6,1"
                                            Background="{DynamicResource Fb.SubtleHoverBrush}">
                                        <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.SubtleHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </ui:TitleBar.CenterContent>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">

                    <!-- Running time tracker -->
                    <Border CornerRadius="15" Height="30" Padding="10,0,4,0" Margin="0,0,6,0" Background="#33F87168"
                            Visibility="{Binding Timer.IsRunning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#F87168" VerticalAlignment="Center" h:Behaviors.AnimateIn="pop" />
                            <Button Style="{StaticResource Fb.GhostButton}" Padding="6,2" Command="{Binding OpenTimerCardCommand}" ToolTip="Open the card being timed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Timer.CardTitle}" MaxWidth="140" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <TextBlock Text="{Binding Timer.ElapsedText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Fb.IconButton}" Width="24" Height="24" Command="{Binding StopTimerCommand}" ToolTip="Stop timer">
                                <ui:SymbolIcon Symbol="Stop24" Filled="True" FontSize="13" Foreground="#F87168" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Pomodoro -->
                    <ToggleButton x:Name="PomodoroToggle" Height="30" Margin="0,0,6,0" Cursor="Hand" ToolTip="Focus timer (Ctrl+P)">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" CornerRadius="15" Padding="10,0" Background="{DynamicResource Fb.SubtleBrush}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.SubtleHoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Pomodoro.IsRunning}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#40F87168" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Pomodoro.IsBreak}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#404BCE97" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="15" Foreground="{DynamicResource Fb.TextBrush}" />
                            <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Fb.TextBrush}"
                                       Text="{Binding Pomodoro.DisplayText}" FontFamily="Consolas"
                                       Visibility="{Binding Pomodoro.IsActive, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Fb.TextBrush}" Text="Focus"
                                       Visibility="{Binding Pomodoro.IsActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=PomodoroToggle}" Placement="Bottom"
                           HorizontalOffset="-120" IsOpen="{Binding IsChecked, ElementName=PomodoroToggle}">
                        <Border Style="{StaticResource Fb.Flyout}" Width="300" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{Binding Pomodoro.PhaseText}" Style="{StaticResource Fb.Caption}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Pomodoro.DisplayText}" FontSize="48" FontWeight="Light" HorizontalAlignment="Center"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{DynamicResource Fb.TextBrush}" />
                                <ProgressBar Style="{StaticResource Fb.ThinProgress}" Maximum="1" Value="{Binding Pomodoro.Progress, Mode=OneWay}" Margin="0,4,0,14" />
                                <UniformGrid Columns="3">
                                    <Button Style="{StaticResource Fb.AccentButton}" Margin="0,0,4,0" Command="{Binding TogglePomodoroCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="14"
                                                           Visibility="{Binding Pomodoro.IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <ui:SymbolIcon Symbol="Pause24" Filled="True" FontSize="14"
                                                           Visibility="{Binding Pomodoro.IsRunning, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Margin="6,0,0,0" Text="Start"
                                                       Visibility="{Binding Pomodoro.IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                            <TextBlock Margin="6,0,0,0" Text="Pause" Visibility="{Binding Pomodoro.IsRunning, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Fb.SubtleButton}" Margin="2,0" HorizontalContentAlignment="Center"
                                            Command="{Binding SkipPomodoroCommand}" Content="Skip" ToolTip="Skip to the next phase" />
                                    <Button Style="{StaticResource Fb.SubtleButton}" Margin="4,0,0,0" HorizontalContentAlignment="Center"
                                            Command="{Binding ResetPomodoroCommand}" Content="Reset" />
                                </UniformGrid>
                                <Border Style="{StaticResource Fb.Section}" Margin="0,14,0,0" Padding="10"
                                        Visibility="{Binding Pomodoro.LinkedCardTitle, Converter={StaticResource HasValueToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Fb.GhostButton}" Padding="4" Command="{Binding OpenPomodoroCardCommand}">
                                            <StackPanel>
                                                <TextBlock Text="Focusing on" Style="{StaticResource Fb.Caption}" />
                                                <TextBlock Text="{Binding Pomodoro.LinkedCardTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource Fb.IconButton}" Command="{Binding UnlinkPomodoroCardCommand}" ToolTip="Unlink card">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource Fb.Muted}" TextAlignment="Center">
                                    <Run Text="Sessions completed today:" /> <Run Text="{Binding Pomodoro.CompletedSessions, Mode=OneWay}" FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="Tip: open a card and press Focus to log time to it." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Style="{StaticResource Fb.IconButton}" Command="{Binding DoUndoCommand}" IsEnabled="{Binding Undo.CanUndo}"
                            ToolTip="{Binding Undo.UndoDescription, StringFormat='Undo {0} (Ctrl+Z)', TargetNullValue='Undo (Ctrl+Z)'}">
                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource Fb.IconButton}" Command="{Binding DoRedoCommand}" IsEnabled="{Binding Undo.CanRedo}"
                            ToolTip="{Binding Undo.RedoDescription, StringFormat='Redo {0} (Ctrl+Y)', TargetNullValue='Redo (Ctrl+Y)'}">
                        <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource Fb.IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle dark / light (Ctrl+T)">
                        <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherMoon24" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource Fb.IconButton}" Command="{Binding OpenShortcutsCommand}" ToolTip="Keyboard shortcuts (F1)">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource Fb.IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings (Ctrl+,)">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Width="260" Background="{DynamicResource Fb.SidebarBrush}"
                    BorderBrush="{DynamicResource Fb.DividerBrush}" BorderThickness="0,1,1,0"
                    Visibility="{Binding Settings.SidebarVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="12,10,12,10">
                    <Grid DockPanel.Dock="Top" Margin="4,0,0,8">
                        <TextBlock Text="Boards" Style="{StaticResource Fb.SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Fb.IconButton}" Command="{Binding NewBoardCommand}" ToolTip="New board (Ctrl+Shift+N)">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource Fb.IconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="Hide sidebar (Ctrl+B)">
                                <ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ui:TextBox DockPanel.Dock="Top" PlaceholderText="Find a board" Margin="0,0,0,10" ClearButtonEnabled="True"
                                Text="{Binding SidebarQuery, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Separator Margin="0,0,0,6" Background="{DynamicResource Fb.DividerBrush}" />
                        <Button Style="{StaticResource Fb.GhostButton}" Command="{Binding ImportBoardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowImport24" FontSize="16" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                <TextBlock Margin="10,0,0,0" Text="Import board" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Fb.GhostButton}" Command="{Binding BackupNowCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SaveCopy24" FontSize="16" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                <TextBlock Margin="10,0,0,0" Text="Back up everything" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Grid Margin="6,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#FEA362">
                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource Initials}}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="#1D2125" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Fb.TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Stored locally on this PC" Style="{StaticResource Fb.Muted}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Visibility="{Binding StarredBoards, Converter={StaticResource HasValueToVis}}">
                                <TextBlock Text="STARRED" Style="{StaticResource Fb.Caption}" Margin="6,4,0,4" />
                                <ItemsControl ItemsSource="{Binding StarredBoards}" ItemTemplate="{StaticResource SidebarBoardTemplate}" />
                                <Separator Margin="0,8" Background="{DynamicResource Fb.DividerBrush}" />
                            </StackPanel>
                            <TextBlock Text="YOUR BOARDS" Style="{StaticResource Fb.Caption}" Margin="6,4,0,4" />
                            <ItemsControl ItemsSource="{Binding AllBoards}" ItemTemplate="{StaticResource SidebarBoardTemplate}" />
                            <Button Style="{StaticResource Fb.GhostButton}" Margin="0,4,0,0" Command="{Binding NewBoardCommand}"
                                    Foreground="{DynamicResource Fb.MutedTextBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                    <TextBlock Margin="10,0,0,0" Text="Create new board" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Board area -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <Border x:Name="BoardBackground" Background="{Binding CurrentBoard.Background, Converter={StaticResource BoardBackground}}" />
                <Border Background="Black" Opacity="{Binding CurrentBoard.BackgroundDim}" />

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding CurrentBoard, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="96" Height="96" Margin="0,0,0,18" />
                    <TextBlock Text="No board open" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Create a board from a template or start from scratch. Everything stays on this PC."
                               Foreground="#DDFFFFFF" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20" />
                    <Button Style="{StaticResource Fb.AccentButton}" HorizontalAlignment="Center" Command="{Binding NewBoardCommand}" Padding="18,9">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                            <TextBlock Text="Create a board" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <DockPanel Visibility="{Binding CurrentBoard, Converter={StaticResource HasValueToVis}}">
                    <!-- Board header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Fb.HeaderBarBrush}" Padding="10,8" TextElement.Foreground="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Fb.HeaderButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="Show sidebar (Ctrl+B)"
                                        Visibility="{Binding Settings.SidebarVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" />
                                </Button>

                                <!-- Board name: click to rename -->
                                <Grid VerticalAlignment="Center" Margin="4,0">
                                    <Button Style="{StaticResource Fb.HeaderButton}" Command="{Binding StartRenameBoardCommand}" ToolTip="Rename board"
                                            Visibility="{Binding CurrentBoard.IsEditingName, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <TextBlock Text="{Binding CurrentBoard.Name}" FontSize="18" FontWeight="Bold" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <TextBox Style="{StaticResource Fb.Input}" FontSize="17" FontWeight="Bold" MinWidth="220" TextWrapping="NoWrap"
                                             Text="{Binding CurrentBoard.Name, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding CurrentBoard.IsEditingName, Converter={StaticResource BoolToVis}}"
                                             h:Behaviors.FocusWhen="{Binding CurrentBoard.IsEditingName}" h:Behaviors.SelectAllOnFocus="True"
                                             h:Behaviors.EnterCommand="{Binding CommitBoardNameCommand}"
                                             h:Behaviors.EscapeCommand="{Binding CommitBoardNameCommand}"
                                             h:Behaviors.LostFocusCommand="{Binding CommitBoardNameCommand}" />
                                </Grid>

                                <Button Style="{StaticResource Fb.HeaderButton}" Command="{Binding ToggleStarCommand}" ToolTip="Star this board">
                                    <ui:SymbolIcon Symbol="Star24" FontSize="16" Filled="{Binding CurrentBoard.IsStarred}" />
                                </Button>

                                <Border Width="1" Height="20" Background="#40FFFFFF" Margin="8,0" />

                                <!-- View switcher -->
                                <Border CornerRadius="8" Background="#33000000" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Fb.Segment}" Foreground="White" GroupName="View" ToolTip="Board (Ctrl+1)"
                                                     IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Board}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Board24" FontSize="15" />
                                                <TextBlock Text="Board" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Fb.Segment}" Foreground="White" GroupName="View" ToolTip="Table (Ctrl+2)"
                                                     IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Table}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Table24" FontSize="15" />
                                                <TextBlock Text="Table" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Fb.Segment}" Foreground="White" GroupName="View" ToolTip="Calendar (Ctrl+3)"
                                                     IsChecked="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Calendar}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="15" />
                                                <TextBlock Text="Calendar" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <!-- Filter -->
                                <ToggleButton x:Name="FilterToggle" Style="{StaticResource Fb.HeaderToggle}" IsChecked="{Binding IsFilterOpen}" ToolTip="Filter cards (Ctrl+F)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Filter24" FontSize="16" />
                                        <TextBlock Text="Filter" Margin="6,0,0,0" />
                                        <Border Margin="6,0,0,0" CornerRadius="8" MinWidth="18" Padding="5,0" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding Filter.IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Filter.ActiveCount}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>
                                <Button Style="{StaticResource Fb.HeaderButton}" Command="{Binding ClearFilterCommand}" ToolTip="Clear filter"
                                        Visibility="{Binding Filter.IsActive, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                </Button>
                                <Popup x:Name="FilterPopup" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=FilterToggle}"
                                       IsOpen="{Binding IsFilterOpen}" HorizontalOffset="-220">
                                    <Border Style="{StaticResource Fb.Flyout}" Width="340">
                                        <StackPanel>
                                            <TextBlock Text="Filter" Style="{StaticResource Fb.SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <TextBlock Text="Keyword" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                                            <ui:TextBox x:Name="FilterText" PlaceholderText="Search titles, descriptions, labels…" ClearButtonEnabled="True"
                                                        Text="{Binding Filter.Text, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="Labels" Style="{StaticResource Fb.Caption}" Margin="0,12,0,4" />
                                            <ItemsControl ItemsSource="{Binding Filter.LabelOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                            <Border CornerRadius="4" Height="26" MinWidth="200" Padding="10,0"
                                                                    Background="{Binding Label.Color, Converter={StaticResource HexToBrush}}">
                                                                <TextBlock Text="{Binding Label.Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                           Foreground="{Binding Label.Color, Converter={StaticResource ContrastBrush}}" />
                                                            </Border>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Due date" Style="{StaticResource Fb.Caption}" Margin="0,12,0,4" />
                                            <WrapPanel>
                                                <RadioButton Style="{StaticResource Fb.Segment}" Content="Any" IsChecked="{Binding Filter.Due, Converter={StaticResource Equals}, ConverterParameter=Any}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" Content="Overdue" IsChecked="{Binding Filter.Due, Converter={StaticResource Equals}, ConverterParameter=Overdue}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" Content="Today" IsChecked="{Binding Filter.Due, Converter={StaticResource Equals}, ConverterParameter=Today}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" Content="Next 7 days" IsChecked="{Binding Filter.Due, Converter={StaticResource Equals}, ConverterParameter=ThisWeek}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" Content="Has date" IsChecked="{Binding Filter.Due, Converter={StaticResource Equals}, ConverterParameter=HasDate}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" Content="No date" IsChecked="{Binding Filter.Due, Converter={StaticResource Equals}, ConverterParameter=NoDate}" />
                                            </WrapPanel>

                                            <TextBlock Text="Minimum priority" Style="{StaticResource Fb.Caption}" Margin="0,12,0,4" />
                                            <WrapPanel>
                                                <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Prio" Content="Any" IsChecked="{Binding Filter.MinPriority, Converter={StaticResource Equals}, ConverterParameter=None}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Prio" Content="Low+" IsChecked="{Binding Filter.MinPriority, Converter={StaticResource Equals}, ConverterParameter=Low}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Prio" Content="Medium+" IsChecked="{Binding Filter.MinPriority, Converter={StaticResource Equals}, ConverterParameter=Medium}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Prio" Content="High+" IsChecked="{Binding Filter.MinPriority, Converter={StaticResource Equals}, ConverterParameter=High}" />
                                                <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Prio" Content="Urgent" IsChecked="{Binding Filter.MinPriority, Converter={StaticResource Equals}, ConverterParameter=Urgent}" />
                                            </WrapPanel>

                                            <CheckBox Margin="0,12,0,0" Content="Hide completed cards" IsChecked="{Binding Filter.HideCompleted}" />
                                            <Button Style="{StaticResource Fb.SubtleButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" Content="Clear filter" Command="{Binding ClearFilterCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <Button Style="{StaticResource Fb.HeaderButton}" Command="{Binding OpenArchiveCommand}" ToolTip="Archived items">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Archive24" FontSize="16" />
                                        <TextBlock Text="{Binding CurrentBoard.ArchivedCount}" Margin="6,0,0,0"
                                                   Visibility="{Binding CurrentBoard.ArchivedCount, Converter={StaticResource HasValueToVis}}" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource Fb.HeaderButton}" h:Behaviors.ClickOpensContextMenu="True" ToolTip="Board menu">
                                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Change background…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenBoardSettingsCommand}" CommandParameter="background">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="PaintBrush24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Labels…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenBoardSettingsCommand}" CommandParameter="labels">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Tag24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Archived items" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenArchiveCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Archive24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Add list" InputGestureText="Ctrl+Shift+L" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=StartAddListCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="ColumnTriple24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Save as template…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SaveAsTemplateCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Bookmark24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Duplicate board" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DuplicateBoardCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Export board…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ExportBoardCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowExport24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Delete board…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteBoardCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Views -->
                    <Grid x:Name="ViewHost">
                        <views:BoardView Visibility="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Board}" />
                        <views:TableView Visibility="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Table}" />
                        <views:CalendarView Visibility="{Binding ViewMode, Converter={StaticResource Equals}, ConverterParameter=Calendar}" />
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- ================= Dialog stack ================= -->
            <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Dialogs}" Focusable="False"
                          Visibility="{Binding HasDialog, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border Background="{DynamicResource Fb.OverlayBrush}" h:Behaviors.AnimateIn="fade">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=BackdropClickedCommand}" />
                                </Border.InputBindings>
                            </Border>
                            <ContentPresenter Content="{Binding}" h:Behaviors.AnimateIn="pop" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= Toasts ================= -->
            <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                          Margin="0,0,0,24" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ToastMessage}">
                        <Border x:Name="Toast" Background="{DynamicResource Fb.ToastBrush}" CornerRadius="10" Padding="16,8,8,8" Margin="0,6,0,0"
                                MinWidth="280" MaxWidth="560" Effect="{StaticResource Fb.PopupShadow}" h:Behaviors.AnimateIn="rise">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="Icon" Symbol="CheckmarkCircle24" Filled="True" FontSize="18" Foreground="#4BCE97" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                                <Button Grid.Column="2" Style="{StaticResource Fb.GhostButton}" Foreground="#85B8FF" FontWeight="SemiBold" Margin="10,0,0,0"
                                        Content="{Binding ActionText}" Command="{Binding InvokeCommand}"
                                        Visibility="{Binding ActionText, Converter={StaticResource HasValueToVis}}" />
                                <Button Grid.Column="3" Style="{StaticResource Fb.IconButton}" Width="28" Height="28" Foreground="#B0FFFFFF"
                                        Command="{Binding DismissCommand}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                                <Setter TargetName="Icon" Property="Foreground" Value="#F87168" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
