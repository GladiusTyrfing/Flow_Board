<UserControl x:Class="FlowBoard.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Width="236">
    <StackPanel>
        <!-- Saturation / brightness -->
        <Grid x:Name="SvArea" Height="150" Cursor="Cross" MouseLeftButtonDown="OnSvDown" MouseMove="OnSvMove" MouseLeftButtonUp="OnRelease"
              ClipToBounds="True">
            <Border x:Name="HueFill" CornerRadius="{DynamicResource Fb.Radius}" />
            <Border CornerRadius="{DynamicResource Fb.Radius}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="{DynamicResource Fb.Radius}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="Black" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Hue -->
        <Grid x:Name="HueArea" Height="14" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnRelease">
            <Border CornerRadius="7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.167" />
                        <GradientStop Color="#00FF00" Offset="0.333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.667" />
                        <GradientStop Color="#FF00FF" Offset="0.833" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Border x:Name="HueThumb" Width="8" Height="18" Canvas.Top="-2" CornerRadius="3" BorderBrush="White" BorderThickness="2" />
            </Canvas>
        </Grid>

        <!-- Hex + preview -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Preview" Width="34" Height="30" CornerRadius="{DynamicResource Fb.Radius}" BorderThickness="1" BorderBrush="{DynamicResource Fb.DividerBrush}" />
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.SubtleBrush}">
                <TextBox x:Name="HexBox" Style="{StaticResource Fb.LineField}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Tag="#RRGGBB"
                         LostKeyboardFocus="OnHexCommit" KeyDown="OnHexKey" />
            </Border>
        </Grid>

        <!-- Presets + recent -->
        <ItemsControl x:Name="PresetList" Margin="0,10,0,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Fb.SwatchButton}" Width="19" Height="19" Margin="2" Focusable="False" ToolTip="{Binding}"
                            Background="{Binding Converter={StaticResource HexToBrush}}" Click="OnSwatch" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="RecentTitle" Text="RECENT" Style="{StaticResource Fb.Caption}" Margin="2,8,0,2" />
        <ItemsControl x:Name="RecentList" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="10" Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Fb.SwatchButton}" Width="19" Height="19" Margin="2" Focusable="False" ToolTip="{Binding}"
                            Background="{Binding Converter={StaticResource HexToBrush}}" Click="OnSwatch" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
