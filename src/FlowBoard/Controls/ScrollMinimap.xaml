<UserControl x:Class="FlowBoard.Controls.ScrollMinimap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Self" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
    <Grid>
        <Border x:Name="Panel" Background="{DynamicResource Fb.SurfaceBrush}" BorderBrush="{DynamicResource Fb.PanelBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource Fb.Radius}" Padding="5" Effect="{StaticResource Fb.PopupShadow}" Opacity="0.94">
            <Grid>
                <Canvas x:Name="Map" Background="Transparent" ClipToBounds="True" Cursor="Hand"
                        MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp">
                    <Rectangle x:Name="Preview" IsHitTestVisible="False" />
                    <Border x:Name="ViewportBox" BorderBrush="{DynamicResource Fb.AccentBrush}" BorderThickness="1.5" CornerRadius="3"
                            Background="{DynamicResource Fb.AccentSoftBrush}" IsHitTestVisible="False" />
                </Canvas>
                <Button Style="{StaticResource Fb.IconButton}" Width="18" Height="18" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-3,-3,0" Click="OnHide" ToolTip="Hide the map" Focusable="False">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="9" />
                </Button>
            </Grid>
        </Border>
        <Button x:Name="ShowButton" Style="{StaticResource Fb.SubtleButton}" Padding="7" Click="OnShow" ToolTip="Show the map" Focusable="False"
                Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <ui:SymbolIcon Symbol="Map24" FontSize="15" />
        </Button>
    </Grid>
</UserControl>
