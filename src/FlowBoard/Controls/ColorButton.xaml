<UserControl x:Class="FlowBoard.Controls.ColorButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:FlowBoard.Controls"
             x:Name="Self" Width="22" Height="22">
    <Grid>
        <!-- Rainbow swatch with a "+" = pick any color -->
        <Button x:Name="Opener" Style="{StaticResource Fb.SwatchButton}" Width="{Binding Width, ElementName=Self}" Height="{Binding Height, ElementName=Self}"
                Focusable="False" Click="OnOpen" ToolTip="{Binding ToolTip, ElementName=Self, TargetNullValue='Custom color…'}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EF4444" Offset="0" />
                    <GradientStop Color="#FACC15" Offset="0.3" />
                    <GradientStop Color="#22C55E" Offset="0.5" />
                    <GradientStop Color="#3B82F6" Offset="0.75" />
                    <GradientStop Color="#A855F7" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <ui:SymbolIcon Symbol="Add24" FontSize="11" Foreground="White" />
        </Button>
        <Popup x:Name="Pop" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=Opener}" Closed="OnClosed">
            <Border Style="{StaticResource Fb.Flyout}" Padding="12">
                <StackPanel>
                    <c:ColorPicker x:Name="Picker" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource Fb.SubtleButton}" Content="Cancel" Margin="0,0,6,0" Click="OnCancel" />
                        <Button Style="{StaticResource Fb.AccentButton}" Content="Use color" Click="OnApply" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
