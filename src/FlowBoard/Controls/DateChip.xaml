<UserControl x:Class="FlowBoard.Controls.DateChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Self">
    <Grid>
        <Button x:Name="Chip" Style="{StaticResource Fb.SubtleButton}" Padding="8,4" Click="OnOpen" Focusable="False" BorderThickness="0">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                <TextBlock x:Name="Label" Margin="6,0,0,0" FontSize="12" />
            </StackPanel>
        </Button>
        <Popup x:Name="Pop" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=Chip}">
            <Border Style="{StaticResource Fb.Flyout}" Padding="10">
                <StackPanel>
                    <Calendar x:Name="Cal" SelectedDatesChanged="OnPicked" />
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Button Style="{StaticResource Fb.SubtleButton}" Content="Today" Margin="0,0,4,0" HorizontalContentAlignment="Center" Click="OnToday" />
                        <Button Style="{StaticResource Fb.SubtleButton}" Content="Tomorrow" Margin="2,0" HorizontalContentAlignment="Center" Click="OnTomorrow" />
                        <Button Style="{StaticResource Fb.SubtleButton}" Content="Clear" Margin="4,0,0,0" HorizontalContentAlignment="Center" Click="OnClear" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
