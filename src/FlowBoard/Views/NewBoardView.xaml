<UserControl x:Class="FlowBoard.Views.NewBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:models="clr-namespace:FlowBoard.Models"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:NewBoardViewModel}">
    <Border Style="{StaticResource Fb.Dialog}" Width="760" Margin="0,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Live preview -->
            <Border CornerRadius="14,0,0,14" Background="{Binding Background, Converter={StaticResource BoardBackground}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <TextBlock Text="{Binding PreviewName}" Foreground="White" FontSize="20" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" MaxWidth="240" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding SelectedTemplate.Lists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="260" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="76" Height="92" CornerRadius="6" Background="{DynamicResource Fb.ListBrush}" Margin="0,0,6,6" Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                        <Border Height="14" CornerRadius="3" Margin="0,5,0,0" Background="{DynamicResource Fb.CardBrush}" />
                                        <Border Height="14" CornerRadius="3" Margin="0,4,0,0" Background="{DynamicResource Fb.CardBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="24">
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Create board" Style="{StaticResource Fb.DialogTitle}" />
                    <Button Style="{StaticResource Fb.IconButton}" HorizontalAlignment="Right" Command="{Binding CloseCommand}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </Button>
                </Grid>

                <TextBlock Text="Board title" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                <ui:TextBox PlaceholderText="e.g. Trident" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            h:Behaviors.FocusOnLoad="True" h:Behaviors.EnterCommand="{Binding CreateCommand}" />

                <TextBlock Text="Background" Style="{StaticResource Fb.Caption}" Margin="0,14,0,6" />
                <ItemsControl ItemsSource="{Binding Backgrounds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Fb.SwatchButton}" Width="54" Height="36" Background="{Binding Converter={StaticResource BoardThumbnail}}"
                                    Command="{Binding DataContext.PickBackgroundCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Fb.Muted}" Text="You can use your own photo later from the board menu." Margin="0,0,0,0" />

                <TextBlock Text="Template" Style="{StaticResource Fb.Caption}" Margin="0,14,0,6" />
                <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MaxHeight="230"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BoardTemplate}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource StringToSymbol}}" FontSize="18" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Fb.Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="Del" Grid.Column="2" Style="{StaticResource Fb.IconButton}" Width="26" Height="26" ToolTip="Delete template" Visibility="Collapsed"
                                        Command="{Binding DataContext.DeleteTemplateCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                    <Setter TargetName="Del" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Style="{StaticResource Fb.AccentButton}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,9" Command="{Binding CreateCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                        <TextBlock Text="Create" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
