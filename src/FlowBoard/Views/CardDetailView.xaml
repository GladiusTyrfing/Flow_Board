<UserControl x:Class="FlowBoard.Views.CardDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:models="clr-namespace:FlowBoard.Models"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:CardDetailViewModel}"
             PreviewKeyDown="Root_PreviewKeyDown"
             Focusable="True" FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <!-- Small action button in the card's action row -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Fb.SubtleButton}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Fb.MutedTextBrush}" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource Fb.GhostButton}">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Fb.MutedTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="Card" Style="{StaticResource Fb.Dialog}" MaxWidth="1100" Margin="32,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            AllowDrop="True" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
        <Grid h:Behaviors.ClipRadius="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Header ============ -->
            <Grid Margin="16,12,12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="in list" Style="{StaticResource Fb.Muted}" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <ComboBox MinWidth="170" ItemsSource="{Binding Lists}" SelectedItem="{Binding CurrentList}" DisplayMemberPath="Name"
                              ToolTip="Move this card to another list" IsEnabled="{Binding IsArchived, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{Binding Board.Name}" Style="{StaticResource Fb.Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border Margin="12,0,0,0" CornerRadius="6" Padding="10,4" Background="#33F5CD47"
                            Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Archive24" FontSize="14" Foreground="#F5CD47" />
                            <TextBlock Text="This card is archived." Margin="6,0,8,0" Foreground="{DynamicResource Fb.TextBrush}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Restore" Command="{Binding RestoreCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CoverBtn" Style="{StaticResource Fb.IconButton}" ToolTip="Cover" h:Behaviors.OpensPopup="{Binding ElementName=CoverPopup}">
                        <ui:SymbolIcon Symbol="Image24" FontSize="16" />
                    </Button>
                    <Button x:Name="MoreBtn" Style="{StaticResource Fb.IconButton}" ToolTip="More actions" h:Behaviors.ClickOpensContextMenu="True">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Duplicate card" Command="{Binding DuplicateCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy title" Command="{Binding CopyTitleCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentCopy24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Start focus session" Command="{Binding StartFocusCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Timer24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Archive" Command="{Binding ArchiveCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Archive24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete…" Command="{Binding DeleteCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource Fb.IconButton}" ToolTip="Close (Esc)" Command="{Binding CloseCommand}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Cover ============ -->
            <Grid Grid.Row="1">
                <Border Height="170" Visibility="{Binding Card.CoverImagePath, Converter={StaticResource HasValueToVis}}">
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Card.CoverImagePath, Converter={StaticResource ImagePath}, ConverterParameter=1200}" />
                    </Border.Background>
                </Border>
                <Border Height="64" Background="{Binding Card.CoverColor, Converter={StaticResource HexToBrush}}"
                        Visibility="{Binding Card.HasCoverColor, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- ============ Body ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel Margin="24,10,18,28">

                        <!-- Title -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource Fb.RoundCheck}" Width="22" Height="22" Margin="0,8,8,0" VerticalAlignment="Top"
                                      IsChecked="{Binding Card.IsCompleted, Mode=OneWay}" Command="{Binding ToggleCompleteCommand}" ToolTip="Mark complete" />
                            <TextBox Grid.Column="1" Style="{StaticResource Fb.InlineTextBox}" FontSize="22" FontWeight="SemiBold"
                                     Text="{Binding Card.Title, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!-- Actions -->
                        <WrapPanel Margin="30,12,0,0">
                            <Button x:Name="LabelsBtn" Style="{StaticResource ActionButton}" h:Behaviors.OpensPopup="{Binding ElementName=LabelsPopup}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Tag24" FontSize="15" />
                                    <TextBlock Text="Labels" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DatesBtn" Style="{StaticResource ActionButton}" h:Behaviors.OpensPopup="{Binding ElementName=DatesPopup}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="15" />
                                    <TextBlock Text="Dates" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding AddChecklistCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckboxChecked24" FontSize="15" />
                                    <TextBlock Text="Checklist" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PriorityBtn" Style="{StaticResource ActionButton}" h:Behaviors.OpensPopup="{Binding ElementName=PriorityPopup}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flag24" FontSize="15" />
                                    <TextBlock Text="Priority" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding AddFilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Attach24" FontSize="15" />
                                    <TextBlock Text="Attach" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding AddLinkCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Link24" FontSize="15" />
                                    <TextBlock Text="Link" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding StartRecordingCommand}"
                                    IsEnabled="{Binding Recorder.IsRecording, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Mic24" FontSize="15" />
                                    <TextBlock Text="Voice" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding ToggleTimerCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Timer24" FontSize="15" />
                                    <TextBlock Text="Start timer" Margin="6,0,0,0" Visibility="{Binding Card.IsTimerRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <TextBlock Text="Stop timer" Margin="6,0,0,0" Foreground="#F87168" Visibility="{Binding Card.IsTimerRunning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding StartFocusCommand}" ToolTip="Start a Pomodoro focus session linked to this card">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Target24" FontSize="15" />
                                    <TextBlock Text="Focus" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoveBtn" Style="{StaticResource ActionButton}" h:Behaviors.OpensPopup="{Binding ElementName=MovePopup}"
                                    Visibility="{Binding OtherBoards, Converter={StaticResource HasValueToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="15" />
                                    <TextBlock Text="Move" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Meta: labels, dates, priority, time -->
                        <WrapPanel Margin="30,6,0,0">
                            <StackPanel Margin="0,0,24,8" Visibility="{Binding Card.HasLabels, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Labels" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Card.ResolvedLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:Label}">
                                            <Border CornerRadius="999" MinWidth="44" Height="30" Padding="14,0" Margin="0,0,6,6"
                                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Foreground="{Binding Color, Converter={StaticResource ContrastBrush}}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,8" Visibility="{Binding Card.HasDue, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Due date" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                                <Button Style="{StaticResource Fb.SubtleButton}" Padding="10,5" h:Behaviors.OpensPopup="{Binding ElementName=DatesPopup}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Card.DueText}" />
                                        <Border Margin="8,0,0,0" CornerRadius="3" Padding="5,1" Background="{Binding Card.DueState, Converter={StaticResource DueStateToBrush}}">
                                            <TextBlock x:Name="DueStateText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fb.OnStatusBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Card.DueState}" Value="Overdue">
                                                                <Setter Property="Text" Value="Overdue" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Card.DueState}" Value="Soon">
                                                                <Setter Property="Text" Value="Due soon" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Card.DueState}" Value="Done">
                                                                <Setter Property="Text" Value="Complete" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ui:SymbolIcon Symbol="AlertOn24" FontSize="13" Margin="8,0,0,0" ToolTip="Reminder set"
                                                       Visibility="{Binding Card.HasReminder, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Card.Priority}" Value="None">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Priority" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                                <Button Style="{StaticResource Fb.SubtleButton}" Padding="10,5" h:Behaviors.OpensPopup="{Binding ElementName=PriorityPopup}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Card.Priority, Converter={StaticResource PriorityToBrush}}" />
                                        <TextBlock Text="{Binding Card.Priority}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Margin="0,0,24,8" Visibility="{Binding Card.HasTrackedTime, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Time tracked" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                                <Border CornerRadius="6" Padding="10,6" Background="{DynamicResource Fb.SubtleBrush}">
                                    <TextBlock Text="{Binding Card.TrackedTimeText}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Description -->
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <ui:SymbolIcon Symbol="TextDescription24" Style="{StaticResource SectionIcon}" />
                            <TextBlock Text="Description" Style="{StaticResource Fb.SectionTitle}" />
                        </StackPanel>
                        <ui:TextBox Margin="30,0,0,0" MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                    PlaceholderText="Add a more detailed description…" SpellCheck.IsEnabled="True"
                                    Text="{Binding Card.Description, UpdateSourceTrigger=PropertyChanged, Delay=250}" />

                        <!-- Drop hint -->
                        <Border Margin="30,14,0,0" CornerRadius="10" Height="70" BorderThickness="2" Background="{DynamicResource Fb.SubtleBrush}"
                                BorderBrush="{DynamicResource Fb.AccentBrush}"
                                Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{DynamicResource Fb.AccentBrush}" />
                                <TextBlock Text="Drop files to attach them" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Attachments -->
                        <StackPanel Visibility="{Binding Card.FileCount, Converter={StaticResource HasValueToVis}}">
                            <Grid>
                                <StackPanel Style="{StaticResource SectionHeader}">
                                    <ui:SymbolIcon Symbol="Attach24" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Text="Attachments" Style="{StaticResource Fb.SectionTitle}" />
                                </StackPanel>
                                <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                        Content="Add" Command="{Binding AddFilesCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Card.FileAttachments}" Margin="30,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Attachment}">
                                        <Border x:Name="Row" CornerRadius="8" Padding="6" Margin="0,0,0,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Thumbnail -->
                                                <Button Style="{StaticResource Fb.GhostButton}" Padding="0" Height="76" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.OpenAttachmentCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="Open">
                                                    <Grid>
                                                        <Border CornerRadius="6" Background="{DynamicResource Fb.SubtleHoverBrush}">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="{Binding Converter={StaticResource AttachmentIcon}}" FontSize="24" HorizontalAlignment="Center"
                                                                               Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                                                <TextBlock Text="{Binding Extension}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                                           Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border x:Name="Thumb" CornerRadius="6" Visibility="Collapsed">
                                                            <Border.Background>
                                                                <ImageBrush Stretch="UniformToFill" ImageSource="{Binding FullPath, Converter={StaticResource ImagePath}, ConverterParameter=240}" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                                    <TextBlock Style="{StaticResource Fb.Muted}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Added" /> <Run Text="{Binding AddedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" />
                                                        <Run Text="·" /> <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <WrapPanel Margin="-4,4,0,0">
                                                        <Button Style="{StaticResource LinkButton}" Content="Open" Command="{Binding DataContext.OpenExternallyCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                        <Button x:Name="CoverLink" Style="{StaticResource LinkButton}" Content="Make cover" Visibility="Collapsed"
                                                                Command="{Binding DataContext.SetCoverImageCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                        <Button x:Name="FolderLink" Style="{StaticResource LinkButton}" Content="Show in folder" Command="{Binding DataContext.ShowInFolderCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                        <Button x:Name="SaveLink" Style="{StaticResource LinkButton}" Content="Save as…" Command="{Binding DataContext.SaveAttachmentAsCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource LinkButton}" Content="Rename" Command="{Binding DataContext.RenameAttachmentCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource LinkButton}" Content="Delete" Command="{Binding DataContext.RemoveAttachmentCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fb.SubtleBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Image">
                                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="CoverLink" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Link">
                                                <Setter TargetName="FolderLink" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="SaveLink" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="30,2,0,0" Style="{StaticResource Fb.Muted}" Text="Tip: drop files here or press Ctrl+V to paste an image." />
                        </StackPanel>

                        <!-- Voice notes -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Recorder.IsRecording}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Card.VoiceCount, Converter={StaticResource HasValueToVis}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <StackPanel Style="{StaticResource SectionHeader}">
                                    <ui:SymbolIcon Symbol="Mic24" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Text="Voice notes" Style="{StaticResource Fb.SectionTitle}" />
                                </StackPanel>
                                <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                        Content="Record" Command="{Binding StartRecordingCommand}"
                                        Visibility="{Binding Recorder.IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>

                            <!-- Recording panel -->
                            <Border Margin="30,0,0,8" CornerRadius="10" Padding="12" Background="#26F87168"
                                    Visibility="{Binding Recorder.IsRecording, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="#F87168" VerticalAlignment="Center">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Recorder.ElapsedText}" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                               Margin="10,0,14,0" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="2" Style="{StaticResource Fb.ThinProgress}" Height="8" Maximum="1" Foreground="#F87168"
                                                 Value="{Binding Recorder.Level, Mode=OneWay}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0">
                                        <Button Style="{StaticResource Fb.AccentButton}" Command="{Binding StopRecordingCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Stop24" Filled="True" FontSize="14" />
                                                <TextBlock Text="Save" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Fb.SubtleButton}" Margin="6,0,0,0" Content="Discard" Command="{Binding CancelRecordingCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Card.VoiceNotes}" Margin="30,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Attachment}">
                                        <Border CornerRadius="10" Padding="8" Margin="0,0,0,6" Background="{DynamicResource Fb.SubtleBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Width="38" Height="38" Cursor="Hand" Command="{Binding DataContext.TogglePlayCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Ellipse Fill="{DynamicResource Fb.AccentBrush}" />
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="16" Foreground="{DynamicResource Fb.OnAccentBrush}"
                                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                        <ui:SymbolIcon Symbol="Pause24" Filled="True" FontSize="16" Foreground="{DynamicResource Fb.OnAccentBrush}"
                                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Button>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                                        <TextBlock HorizontalAlignment="Right" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource Fb.MutedTextBrush}">
                                                            <Run Text="{Binding PlaybackPositionText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <!-- Click anywhere on the bar to seek -->
                                                    <Grid Height="14" Margin="0,4,0,0" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Seek_MouseLeftButtonDown">
                                                        <ProgressBar Style="{StaticResource Fb.ThinProgress}" Maximum="1" Value="{Binding PlaybackProgress, Mode=OneWay}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource Fb.IconButton}" ToolTip="Save as…" Command="{Binding DataContext.SaveAttachmentAsCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="15" />
                                                    </Button>
                                                    <Button Style="{StaticResource Fb.IconButton}" ToolTip="Delete" Command="{Binding DataContext.RemoveAttachmentCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Checklists -->
                        <ItemsControl ItemsSource="{Binding Card.Checklists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Checklist}">
                                    <StackPanel x:Name="ChecklistRoot" h:Behaviors.AnimateIn="rise">
                                        <Grid Margin="0,18,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="CheckboxChecked24" Style="{StaticResource SectionIcon}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Fb.InlineTextBox}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <ToggleButton IsChecked="{Binding HideCompleted}" Margin="6,0" Padding="10,5" Cursor="Hand"
                                                              Content="Hide checked" ToolTip="Hide checked items" />
                                                <Button Style="{StaticResource Fb.SubtleButton}" Content="Delete" Padding="10,5"
                                                        Command="{Binding DataContext.DeleteChecklistCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Percent, StringFormat='{}{0}%'}" FontSize="11" Style="{StaticResource Fb.Muted}" VerticalAlignment="Center" />
                                            <ProgressBar x:Name="Progress" Grid.Column="1" Style="{StaticResource Fb.ThinProgress}" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="24,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ChecklistItem}">
                                                    <Grid x:Name="ItemRow" Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,2,0" MinWidth="0" />
                                                        <TextBox x:Name="ItemText" Grid.Column="1" Style="{StaticResource Fb.InlineTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                                        <StackPanel x:Name="ItemActions" Grid.Column="2" Orientation="Horizontal" Opacity="0">
                                                            <Button Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="Convert to card"
                                                                    Command="{Binding DataContext.ConvertItemToCardCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" />
                                                            </Button>
                                                            <Button Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="Delete item"
                                                                    Command="{Binding DataContext.DeleteChecklistItemCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="ItemRow" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemActions" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource Fb.MutedTextBrush}" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDone}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.HideCompleted, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="ItemRow" Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ui:TextBox Margin="30,4,0,0" PlaceholderText="Add an item (Enter to add, paste several lines to add many)"
                                                    Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                                    h:Behaviors.EnterCommand="{Binding DataContext.AddChecklistItemCommand, ElementName=Root}"
                                                    h:Behaviors.CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                            <Setter TargetName="Progress" Property="Foreground" Value="{DynamicResource Fb.SuccessBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Time tracking -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Card.TimeEntries.Count, Converter={StaticResource HasValueToVis}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Card.IsTimerRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <StackPanel Style="{StaticResource SectionHeader}">
                                    <ui:SymbolIcon Symbol="Timer24" Style="{StaticResource SectionIcon}" />
                                    <TextBlock Text="Time tracking" Style="{StaticResource Fb.SectionTitle}" />
                                    <TextBlock Text="{Binding Card.TrackedTimeText, StringFormat='· {0} total'}" Style="{StaticResource Fb.Muted}" FontSize="13"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                        Content="Log time…" Command="{Binding LogTimeCommand}" />
                            </Grid>
                            <Border Margin="30,0,0,8" CornerRadius="8" Padding="10,6" Background="#26F87168"
                                    Visibility="{Binding Card.IsTimerRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#F87168" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Run Text="Timer running:" /> <Run Text="{Binding Timer.ElapsedText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Button Style="{StaticResource LinkButton}" Content="Stop" Margin="10,0,0,0" Command="{Binding ToggleTimerCommand}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Card.TimeEntries}" Margin="30,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TimeEntry}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Start, StringFormat='ddd, MMM d · HH:mm'}" Style="{StaticResource Fb.Text}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Duration, StringFormat='{}{0:h\\:mm\\:ss}'}" FontFamily="Consolas" FontSize="12"
                                                       Foreground="{DynamicResource Fb.TextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Fb.Muted}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Style="{StaticResource Fb.IconButton}" Width="26" Height="26" ToolTip="Delete entry"
                                                    Command="{Binding DataContext.DeleteTimeEntryCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Comments & activity ============ -->
                <Border Grid.Column="1" Background="{DynamicResource Fb.SurfaceAltBrush}" CornerRadius="0,0,22,0"
                        BorderBrush="{DynamicResource Fb.DividerBrush}" BorderThickness="1,0,0,0">
                    <DockPanel Margin="16,14,10,14">
                        <Grid DockPanel.Dock="Top" Margin="0,0,6,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CommentMultiple24" FontSize="18" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                <TextBlock Text="Comments and activity" Style="{StaticResource Fb.SectionTitle}" Margin="10,0,0,0" />
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right" Padding="10,4" Cursor="Hand" IsChecked="{Binding ShowActivity}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="Show details" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="Hide details" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,6,12">
                            <ui:TextBox PlaceholderText="Write a comment…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="160"
                                        Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                        h:Behaviors.EnterCommand="{Binding AddCommentCommand}" />
                            <Button Style="{StaticResource Fb.AccentButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Save" Command="{Binding AddCommentCommand}"
                                    Visibility="{Binding NewComment, Converter={StaticResource HasValueToVis}}" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleComments}" Margin="0,0,6,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Comment}">
                                        <Grid Margin="0,0,0,12" h:Behaviors.AnimateIn="fade">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Delete" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteCommentFromOpenCardCommand}" CommandParameter="{Binding}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="#FEA362" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Author, Converter={StaticResource Initials}}" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1D2125" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <!-- Comment -->
                                                <StackPanel x:Name="CommentBody">
                                                    <TextBlock>
                                                        <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fb.TextBrush}" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" Foreground="{DynamicResource Fb.FaintTextBrush}" FontSize="11" />
                                                    </TextBlock>
                                                    <Border CornerRadius="8" Padding="10,7" Margin="0,4,0,0" Background="{DynamicResource Fb.InputBrush}"
                                                            BorderBrush="{DynamicResource Fb.DividerBrush}" BorderThickness="1">
                                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                                 Background="Transparent" Foreground="{DynamicResource Fb.TextBrush}" Padding="0">
                                                            <TextBox.Template>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                                                                </ControlTemplate>
                                                            </TextBox.Template>
                                                        </TextBox>
                                                    </Border>
                                                </StackPanel>
                                                <!-- Activity -->
                                                <TextBlock x:Name="ActivityBody" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13">
                                                    <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Fb.TextBrush}" />
                                                    <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                                    <LineBreak />
                                                    <Run Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" Foreground="{DynamicResource Fb.FaintTextBrush}" FontSize="11" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActivity}" Value="True">
                                                <Setter TargetName="CommentBody" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="ActivityBody" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ Popups ============ -->

            <!-- Labels -->
            <Popup x:Name="LabelsPopup" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=LabelsBtn}">
                <Border Style="{StaticResource Fb.Flyout}" Width="320">
                    <StackPanel>
                        <TextBlock Text="Labels" Style="{StaticResource Fb.SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding LabelOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LabelOption}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" />
                                        <Border Grid.Column="1" CornerRadius="4" Height="32" Padding="10,0" Cursor="Hand"
                                                Background="{Binding Label.Color, Converter={StaticResource HexToBrush}}" MouseLeftButtonUp="LabelChip_MouseLeftButtonUp">
                                            <TextBlock Text="{Binding Label.Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{Binding Label.Color, Converter={StaticResource ContrastBrush}}" />
                                        </Border>
                                        <Button Grid.Column="2" Style="{StaticResource Fb.IconButton}" ToolTip="Edit label"
                                                Command="{Binding DataContext.EditLabelCommand, ElementName=Root}" CommandParameter="{Binding Label}">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Edit selected label -->
                        <Border Style="{StaticResource Fb.Section}" Margin="0,10,0,0" Visibility="{Binding EditingLabel, Converter={StaticResource HasValueToVis}}">
                            <StackPanel>
                                <TextBlock Text="Edit label" Style="{StaticResource Fb.Caption}" Margin="0,0,0,6" />
                                <ui:TextBox PlaceholderText="Label name" Text="{Binding EditingLabel.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding LabelPalette}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Fb.SwatchButton}" Width="38" Height="26" Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.SetEditingLabelColorCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Style="{StaticResource Fb.AccentButton}" Content="Done" Command="{Binding FinishEditingLabelCommand}" />
                                    <Button Style="{StaticResource Fb.DangerButton}" Content="Delete" Margin="8,0,0,0"
                                            Command="{Binding DeleteLabelCommand}" CommandParameter="{Binding EditingLabel}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Create label -->
                        <TextBlock Text="Create a new label" Style="{StaticResource Fb.Caption}" Margin="0,12,0,6" />
                        <Border CornerRadius="4" Height="32" Padding="10,0" Margin="0,0,0,8" Background="{Binding NewLabelColor, Converter={StaticResource HexToBrush}}">
                            <TextBlock Text="{Binding NewLabelName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{Binding NewLabelColor, Converter={StaticResource ContrastBrush}}" />
                        </Border>
                        <ui:TextBox PlaceholderText="Title (optional)" Text="{Binding NewLabelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                    h:Behaviors.EnterCommand="{Binding CreateLabelCommand}" />
                        <ItemsControl ItemsSource="{Binding LabelPalette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Fb.SwatchButton}" Width="38" Height="26" Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.PickNewLabelColorCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Fb.AccentButton}" HorizontalAlignment="Stretch" Margin="0,4,0,0" Content="Create label" Command="{Binding CreateLabelCommand}" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Dates -->
            <Popup x:Name="DatesPopup" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=DatesBtn}">
                <Border Style="{StaticResource Fb.Flyout}" Width="330">
                    <StackPanel>
                        <TextBlock Text="Dates" Style="{StaticResource Fb.SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Style="{StaticResource Fb.SubtleButton}" Content="Today" Margin="0,0,4,4" Padding="8,4" Command="{Binding QuickDueCommand}" CommandParameter="today" />
                            <Button Style="{StaticResource Fb.SubtleButton}" Content="Tomorrow" Margin="0,0,4,4" Padding="8,4" Command="{Binding QuickDueCommand}" CommandParameter="tomorrow" />
                            <Button Style="{StaticResource Fb.SubtleButton}" Content="Weekend" Margin="0,0,4,4" Padding="8,4" Command="{Binding QuickDueCommand}" CommandParameter="weekend" />
                            <Button Style="{StaticResource Fb.SubtleButton}" Content="Next week" Margin="0,0,4,4" Padding="8,4" Command="{Binding QuickDueCommand}" CommandParameter="nextweek" />
                        </WrapPanel>
                        <Calendar SelectedDate="{Binding DueDateValue}" DisplayDate="{Binding DueDateValue, Mode=OneWay, TargetNullValue={x:Static sys:DateTime.Today}}"
                                  HorizontalAlignment="Center" />
                        <CheckBox Content="Start date" IsChecked="{Binding HasStartDate}" Margin="0,10,0,4" />
                        <DatePicker SelectedDate="{Binding StartDateValue}" IsEnabled="{Binding HasStartDate}" />
                        <CheckBox Content="Due date" IsChecked="{Binding HasDueDate}" Margin="0,10,0,4" />
                        <Grid IsEnabled="{Binding HasDueDate}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <DatePicker SelectedDate="{Binding DueDateValue}" />
                            <ui:TextBox Grid.Column="1" Margin="6,0,0,0" PlaceholderText="HH:mm" Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Optional time, e.g. 14:30" />
                        </Grid>
                        <TextBlock Text="Reminder" Style="{StaticResource Fb.Caption}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding ReminderChoices}" SelectedItem="{Binding SelectedReminder}" DisplayMemberPath="Text" />
                        <TextBlock Style="{StaticResource Fb.Muted}" Margin="0,6,0,0" Text="Reminders appear as Windows notifications, even when FlowBoard is in the tray." />
                        <Button Style="{StaticResource Fb.AccentButton}" HorizontalAlignment="Stretch" Margin="0,12,0,6" Content="Save"
                                Command="{Binding ApplyDatesCommand}" h:Behaviors.ClosesPopup="True" />
                        <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Remove"
                                Command="{Binding RemoveDatesCommand}" h:Behaviors.ClosesPopup="True" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Priority -->
            <Popup x:Name="PriorityPopup" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=PriorityBtn}">
                <Border Style="{StaticResource Fb.Flyout}" Width="220">
                    <StackPanel>
                        <TextBlock Text="Priority" Style="{StaticResource Fb.SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Priorities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Priority}">
                                    <Button Style="{StaticResource Fb.GhostButton}" h:Behaviors.ClosesPopup="True"
                                            Command="{Binding DataContext.SetPriorityCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Converter={StaticResource PriorityToBrush}}"
                                                    BorderBrush="{DynamicResource Fb.MutedTextBrush}" BorderThickness="1" />
                                            <TextBlock Text="{Binding Converter={StaticResource PriorityToText}}" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Cover -->
            <Popup x:Name="CoverPopup" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=CoverBtn}" Placement="Bottom" HorizontalOffset="-260">
                <Border Style="{StaticResource Fb.Flyout}" Width="300">
                    <StackPanel>
                        <TextBlock Text="Cover" Style="{StaticResource Fb.SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Colors" Style="{StaticResource Fb.Caption}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding CoverPalette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Fb.SwatchButton}" Width="42" Height="30" Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.SetCoverColorCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Images from attachments" Style="{StaticResource Fb.Caption}" Margin="0,8,0,6"
                                   Visibility="{Binding Card.ImageAttachments, Converter={StaticResource HasValueToVis}}" />
                        <ItemsControl ItemsSource="{Binding Card.ImageAttachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Attachment}">
                                    <Button Style="{StaticResource Fb.SwatchButton}" Width="84" Height="52"
                                            Command="{Binding DataContext.SetCoverImageCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <Button.Background>
                                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding FullPath, Converter={StaticResource ImagePath}, ConverterParameter=200}" />
                                        </Button.Background>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"
                                Content="Remove cover" Command="{Binding RemoveCoverCommand}" h:Behaviors.ClosesPopup="True" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Move to board -->
            <Popup x:Name="MovePopup" Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=MoveBtn}">
                <Border Style="{StaticResource Fb.Flyout}" Width="260">
                    <StackPanel>
                        <TextBlock Text="Move to board" Style="{StaticResource Fb.SectionTitle}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding OtherBoards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Board}">
                                    <Button Style="{StaticResource Fb.GhostButton}" h:Behaviors.ClosesPopup="True"
                                            Command="{Binding DataContext.MoveToBoardCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="18" CornerRadius="3" Background="{Binding Background, Converter={StaticResource BoardThumbnail}}" />
                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
