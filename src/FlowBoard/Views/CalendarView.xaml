<UserControl x:Class="FlowBoard.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:models="clr-namespace:FlowBoard.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <UserControl.Resources>
        <!-- Compact card chip used inside day cells and the "no date" tray -->
        <DataTemplate x:Key="CalendarCardTemplate" DataType="{x:Type models:Card}">
            <Border x:Name="Chip" CornerRadius="{DynamicResource Fb.RadiusSmall}" Padding="6,3" Margin="0,0,0,3" Background="{DynamicResource Fb.CardBrush}" Cursor="Hand"
                    BorderThickness="0,0,0,0" ToolTip="{Binding Title}" MouseLeftButtonUp="Chip_MouseLeftButtonUp"
                    PreviewMouseLeftButtonDown="Chip_PreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" CornerRadius="1.5" Margin="0,1,6,1" Background="{Binding Priority, Converter={StaticResource PriorityToBrush}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                        <ItemsControl ItemsSource="{Binding ResolvedLabels}" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Label}">
                                    <Border Width="18" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Fb.CardHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Chip" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="Overdue">
                    <Setter TargetName="Chip" Property="BorderThickness" Value="2,0,0,0" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Fb.DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="{DynamicResource Fb.RadiusLarge}" Background="{DynamicResource Fb.SurfaceBrush}" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource Fb.ListBorderBrush}" Effect="{StaticResource Fb.CardShadow}">
            <DockPanel>
                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="4,0,4,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Fb.IconButton}" Command="{Binding Calendar.PreviousMonthCommand}" ToolTip="Previous month">
                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource Fb.IconButton}" Command="{Binding Calendar.NextMonthCommand}" ToolTip="Next month">
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                        </Button>
                        <TextBlock Text="{Binding Calendar.MonthTitle}" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fb.TextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="All boards" IsChecked="{Binding Calendar.AllBoards}" Margin="0,0,12,0" />
                        <CheckBox Content="Show completed" IsChecked="{Binding Settings.ShowCompletedInCalendar}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource Fb.SubtleButton}" Content="Today" Command="{Binding Calendar.GoToTodayCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Weekday names -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Calendar.WeekdayNames}" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Fb.Caption}" Margin="8,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Month grid -->
                <ItemsControl ItemsSource="{Binding Calendar.Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CalendarDay}">
                            <Border x:Name="Cell" Margin="3" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.CalendarCellBrush}" Padding="4"
                                    BorderThickness="1.5" BorderBrush="Transparent">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,0,2">
                                        <Border x:Name="DayBadge" HorizontalAlignment="Left" CornerRadius="{DynamicResource Fb.Radius}" MinWidth="22" Height="22" Padding="5,0">
                                            <TextBlock x:Name="DayText" Text="{Binding DayText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" Foreground="{DynamicResource Fb.TextBrush}" />
                                        </Border>
                                        <Button x:Name="AddBtn" Style="{StaticResource Fb.IconButton}" Width="22" Height="22" HorizontalAlignment="Right" Opacity="0"
                                                Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Calendar.AddCardOnDayCommand}" CommandParameter="{Binding}"
                                                ToolTip="Add a card due this day">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="12" />
                                        </Button>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Cards}" MinHeight="30" Background="Transparent"
                                                      ItemTemplate="{StaticResource CalendarCardTemplate}"
                                                      dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DragDropContext="calendar"
                                                      dd:DragDrop.UseDefaultDragAdorner="True"
                                                      dd:DragDrop.DropHandler="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Calendar.DropHandler}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter TargetName="Cell" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Fb.SurfaceRaisedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="DayBadge" Property="Background" Value="{DynamicResource Fb.AccentBrush}" />
                                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource Fb.OnAccentBrush}" />
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Fb.AccentBrush}" />
                                </DataTrigger>
                                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AddBtn" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Unscheduled tray -->
        <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="{DynamicResource Fb.RadiusLarge}" BorderThickness="1" BorderBrush="{DynamicResource Fb.ListBorderBrush}" Background="{DynamicResource Fb.ListBrush}" Padding="10" Effect="{StaticResource Fb.CardShadow}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <TextBlock Text="No due date" Style="{StaticResource Fb.SectionTitle}" />
                    <TextBlock Text="Drag a card onto a day to schedule it. Drop it here to clear its date." Style="{StaticResource Fb.Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Calendar.Unscheduled}" MinHeight="120" Background="Transparent"
                                  ItemTemplate="{StaticResource CalendarCardTemplate}"
                                  dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DragDropContext="calendar"
                                  dd:DragDrop.UseDefaultDragAdorner="True"
                                  dd:DragDrop.DropHandler="{Binding Calendar.DropHandler}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
