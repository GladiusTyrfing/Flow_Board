<UserControl x:Class="FlowBoard.Views.DocStyleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:services="clr-namespace:FlowBoard.Services"
             xmlns:c="clr-namespace:FlowBoard.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:DocStyleViewModel}">
    <Border Style="{StaticResource Fb.Dialog}" Width="380" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,8,8,8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="22,20,16,12">
                <StackPanel>
                    <TextBlock Text="Style" Style="{StaticResource Fb.GradientTitle}" FontSize="22" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Fb.Muted}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,40,0" />
                </StackPanel>
                <Button Style="{StaticResource Fb.IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip="Close (Esc)">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </Button>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Margin="22,8,22,18">
                <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApplyToAllCommand}"
                        Content="Use this style for all storyboards, canvases and pages" Margin="0,0,0,6" />
                <Button Style="{StaticResource Fb.GhostButton}" HorizontalAlignment="Center" Command="{Binding ResetCommand}" Content="Reset to default" FontSize="12" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,16,12">
                <StackPanel>
                    <TextBlock Text="THEME" Style="{StaticResource Fb.Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:BoardThemePreset}">
                                <Button Style="{StaticResource Fb.SwatchButton}" Width="72" Height="50" Margin="0,0,6,6" Background="{Binding ListPreview}" ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SetThemeCommand, ElementName=Root}" CommandParameter="{Binding Name}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource SelectedTag}">
                                            <Binding Path="Name" />
                                            <Binding Path="DataContext.Doc.Theme" ElementName="Root" />
                                        </MultiBinding>
                                    </Button.Tag>
                                    <Grid>
                                        <Border Width="34" Height="16" CornerRadius="3" Background="{Binding CardPreview}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding TextPreview}" VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding Doc.PanelOpacity, Converter={StaticResource Percent}}" DockPanel.Dock="Right" Style="{StaticResource Fb.Muted}" Width="40" TextAlignment="Right" />
                        <TextBlock Text="Panels" Style="{StaticResource Fb.Muted}" Width="80" VerticalAlignment="Center" />
                        <Slider Minimum="0.15" Maximum="1" Value="{Binding Doc.PanelOpacity}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="WALLPAPER" Style="{StaticResource Fb.Caption}" Margin="0,18,0,8" />
                    <ItemsControl ItemsSource="{Binding Gradients}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Fb.SwatchButton}" Width="72" Height="46" Margin="0,0,6,6" Background="{Binding Converter={StaticResource BoardThumbnail}}"
                                        Command="{Binding DataContext.SetBackgroundCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource SelectedTag}">
                                            <Binding />
                                            <Binding Path="DataContext.Doc.Background" ElementName="Root" />
                                        </MultiBinding>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Solids}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Fb.SwatchButton}" Width="44" Height="32" Margin="0,0,6,6" Background="{Binding Converter={StaticResource BoardThumbnail}}"
                                        Command="{Binding DataContext.SetBackgroundCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <c:ColorButton Width="28" Height="24" Command="{Binding SetBackgroundCommand}" Prefix="color:" />
                        <TextBlock Text="Custom color…" Style="{StaticResource Fb.Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Left" Margin="0,12,0,8" Command="{Binding ChooseImageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ImageAdd24" FontSize="15" />
                            <TextBlock Text="Use a photo…" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding RecentImages}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Fb.SwatchButton}" Width="72" Height="46" Margin="0,0,6,6" Background="{Binding Converter={StaticResource BoardThumbnail}}"
                                        Command="{Binding DataContext.SetBackgroundCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding Doc.BackgroundDim, Converter={StaticResource Percent}}" DockPanel.Dock="Right" Style="{StaticResource Fb.Muted}" Width="40" TextAlignment="Right" />
                        <TextBlock Text="Dim" Style="{StaticResource Fb.Muted}" Width="80" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="0.85" Value="{Binding Doc.BackgroundDim}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding Doc.BackgroundBlur, StringFormat={}{0:0}}" DockPanel.Dock="Right" Style="{StaticResource Fb.Muted}" Width="40" TextAlignment="Right" />
                        <TextBlock Text="Blur" Style="{StaticResource Fb.Muted}" Width="80" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="40" Value="{Binding Doc.BackgroundBlur}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
