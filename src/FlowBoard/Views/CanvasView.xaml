<UserControl x:Class="FlowBoard.Views.CanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FlowBoard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:models="clr-namespace:FlowBoard.Models"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             mc:Ignorable="d"
             x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}"
             d:DataContext="{d:DesignInstance vm:CanvasViewModel}">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="{DynamicResource Fb.Radius}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.AccentGradientBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fb.OnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource Fb.IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="Port" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="{DynamicResource Fb.SurfaceBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource Fb.AccentBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Tag" Value="port" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="ToolTip" Value="Drag to connect" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ Header ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Fb.HeaderPill}" Margin="12,12,12,0" Padding="6,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border HorizontalAlignment="Left" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Fb.HeaderButton}" Focusable="False" Command="{Binding Main.ToggleSidebarCommand}" ToolTip="Show sidebar (Ctrl+B)"
                                Visibility="{Binding Main.IsSidebarShown, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" />
                        </Button>
                        <Border Width="30" Height="30" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.AccentGradientBrush}" Margin="4,0,6,0">
                            <ui:SymbolIcon Symbol="Flowchart24" FontSize="16" Foreground="White" />
                        </Border>
                        <Grid VerticalAlignment="Center">
                            <Button Style="{StaticResource Fb.HeaderButton}" Focusable="False" Command="{Binding StartRenameCommand}" ToolTip="Rename"
                                    Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding Doc.Name}" FontSize="18" FontWeight="Bold" MaxWidth="{Binding Main.BoardNameMaxWidth}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBox Style="{StaticResource Fb.Input}" FontSize="17" FontWeight="Bold" MinWidth="220" TextWrapping="NoWrap"
                                     Text="{Binding Doc.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                     h:Behaviors.FocusWhen="{Binding IsEditingName}" h:Behaviors.SelectAllOnFocus="True"
                                     h:Behaviors.EnterCommand="{Binding CommitNameCommand}" h:Behaviors.EscapeCommand="{Binding CommitNameCommand}"
                                     h:Behaviors.LostFocusCommand="{Binding CommitNameCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Fb.Muted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding Main.IsCompact, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                   Text="Double-click to add · drag the dots to connect · Tab adds a child" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource Fb.HeaderButton}" Focusable="False" Command="{Binding AutoLayoutCommand}" ToolTip="Tidy up: arrange shapes left to right along the connectors">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Organization24" FontSize="16" />
                            <TextBlock Text="Tidy up" Margin="6,0,0,0" Visibility="{Binding Main.IsCompact, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Style="{StaticResource Fb.HeaderToggle}" Focusable="False" IsChecked="{Binding Doc.SnapToGrid}" ToolTip="Snap to grid">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="16" />
                            <TextBlock Text="Snap" Margin="6,0,0,0" Visibility="{Binding Main.IsCompact, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource Fb.HeaderButton}" Focusable="False" h:Behaviors.ClickOpensContextMenu="True" ToolTip="More">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export as image…" Command="{Binding ExportImageCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ImageArrowForward24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Print…" Command="{Binding PrintCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Print24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Select all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="SelectAllOn24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Zoom to fit" InputGestureText="Ctrl+0" Command="{Binding ZoomToFitCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowMaximize24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Curved connectors" Command="{Binding SetEdgeStyleCommand}" CommandParameter="{x:Static models:EdgeStyle.Curved}" />
                                <MenuItem Header="Straight connectors" Command="{Binding SetEdgeStyleCommand}" CommandParameter="{x:Static models:EdgeStyle.Straight}" />
                                <MenuItem Header="Elbow connectors" Command="{Binding SetEdgeStyleCommand}" CommandParameter="{x:Static models:EdgeStyle.Elbow}" />
                                <Separator />
                                <MenuItem Header="Duplicate canvas" Command="{Binding Main.DuplicateDocCommand}" CommandParameter="{Binding Doc}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete canvas…" Command="{Binding Main.DeleteDocCommand}" CommandParameter="{Binding Doc}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <!-- ============ Surface ============ -->
            <Border x:Name="Surface" Background="{DynamicResource Fb.SurfaceAltBrush}" BorderBrush="{DynamicResource Fb.DividerBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Fb.RadiusLarge}" h:Behaviors.ClipRadius="{DynamicResource Fb.RadiusLargeValue}" AllowDrop="True"
                    MouseDown="OnMouseDown" MouseMove="OnMouseMove" MouseUp="OnMouseUp" MouseWheel="OnWheel" Drop="OnDrop" DragOver="OnDragOver"
                    SizeChanged="OnSurfaceSize">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add box here" Command="{Binding AddShapeAtContextCommand}" CommandParameter="{x:Static models:NodeShape.Rounded}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="RectangleLandscape24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add sticky note here" Command="{Binding AddShapeAtContextCommand}" CommandParameter="{x:Static models:NodeShape.Sticky}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Note24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add text here" Command="{Binding AddShapeAtContextCommand}" CommandParameter="{x:Static models:NodeShape.Text}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="TextT24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add decision here" Command="{Binding AddShapeAtContextCommand}" CommandParameter="{x:Static models:NodeShape.Diamond}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Diamond24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add section (frame) here" Command="{Binding AddShapeAtContextCommand}" CommandParameter="{x:Static models:NodeShape.Frame}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="GroupList24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding PasteAtContextCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="ClipboardPaste24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add image…" Command="{Binding AddImageCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Image24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add card…" Command="{Binding AddCardCommand}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="TaskListLtr24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Select all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                        <MenuItem Header="Tidy up" Command="{Binding AutoLayoutCommand}" />
                        <MenuItem Header="Zoom to fit" InputGestureText="Ctrl+0" Command="{Binding ZoomToFitCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Rectangle x:Name="Dots" IsHitTestVisible="False" />
                    <Canvas x:Name="WorldHost">
                        <Canvas x:Name="World">
                            <ItemsControl ItemsSource="{Binding Doc.Edges}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CanvasEdge}">
                                        <Canvas>
                                            <Path Data="{Binding PathData, Converter={StaticResource Geometry}}" Stroke="Transparent" StrokeThickness="14" Tag="edge" Cursor="Hand" />
                                            <Path x:Name="Line" Data="{Binding PathData, Converter={StaticResource Geometry}}" Stroke="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                  StrokeThickness="{Binding Thickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" IsHitTestVisible="False" />
                                            <Path x:Name="Head" Data="{Binding ArrowData, Converter={StaticResource Geometry}}" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" IsHitTestVisible="False" />
                                            <Grid Canvas.Left="{Binding LabelLeft}" Canvas.Top="{Binding LabelTop}" Width="240" Height="40"
                                                  Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}">
                                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" Tag="edge"
                                                        CornerRadius="{DynamicResource Fb.RadiusSmall}" Background="{DynamicResource Fb.SurfaceBrush}"
                                                        BorderThickness="1" BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fb.TextBrush}" IsHitTestVisible="False" />
                                                </Border>
                                            </Grid>
                                            <!-- End handles (drag to move an end; drop on a shape to attach) -->
                                            <Ellipse x:Name="FromHandle" Tag="end-from" Canvas.Left="{Binding StartX}" Canvas.Top="{Binding StartY}" Width="12" Height="12"
                                                     Fill="White" Stroke="{DynamicResource Fb.AccentBrush}" StrokeThickness="2" Cursor="Cross" Visibility="Collapsed">
                                                <Ellipse.RenderTransform><TranslateTransform X="-6" Y="-6" /></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="ToHandle" Tag="end-to" Canvas.Left="{Binding EndX}" Canvas.Top="{Binding EndY}" Width="12" Height="12"
                                                     Fill="White" Stroke="{DynamicResource Fb.AccentBrush}" StrokeThickness="2" Cursor="Cross" Visibility="Collapsed">
                                                <Ellipse.RenderTransform><TranslateTransform X="-6" Y="-6" /></Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Canvas>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Dashed}" Value="True">
                                                <Setter TargetName="Line" Property="StrokeDashArray" Value="4 3" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Line" Property="Stroke" Value="{DynamicResource Fb.AccentBrush}" />
                                                <Setter TargetName="Head" Property="Fill" Value="{DynamicResource Fb.AccentBrush}" />
                                                <Setter TargetName="FromHandle" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ToHandle" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Doc.Nodes}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="{Binding Z}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CanvasNode}">
                                        <Grid x:Name="NodeRoot" Width="{Binding Width}" Height="{Binding Height}" Tag="node" Background="Transparent" Cursor="SizeAll">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit text" InputGestureText="F2" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.OpenNodeCommand}" CommandParameter="{Binding}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Crop image…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.CropNodeCommand}" CommandParameter="{Binding}"
                                                              Visibility="{Binding Shape, Converter={StaticResource Equals}, ConverterParameter=Image}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Crop24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Add child" InputGestureText="Tab" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.AddChildCommand}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="BranchFork24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.DuplicateSelectionCommand}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Bring to front" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.BringToFrontCommand}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowUp24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Send to back" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.SendToBackCommand}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowDown24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.DeleteSelectionCommand}">
                                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <!-- Selection halo -->
                                            <Border x:Name="Halo" Margin="-5" BorderThickness="2" BorderBrush="{DynamicResource Fb.AccentBrush}" CornerRadius="{DynamicResource Fb.RadiusLarge}"
                                                    Visibility="Collapsed" IsHitTestVisible="False" />

                                            <!-- Shapes -->
                                            <Border x:Name="Body" Background="{Binding Fill, Converter={StaticResource HexToBrush}}" CornerRadius="3"
                                                    BorderThickness="1" BorderBrush="#26000000" Effect="{StaticResource Fb.CardShadow}" />
                                            <Ellipse x:Name="EllipseShape" Fill="{Binding Fill, Converter={StaticResource HexToBrush}}" Stroke="#26000000" Visibility="Collapsed"
                                                     Effect="{StaticResource Fb.CardShadow}" />
                                            <Path x:Name="DiamondShape" Data="M 0.5,0 L 1,0.5 L 0.5,1 L 0,0.5 Z" Stretch="Fill" Fill="{Binding Fill, Converter={StaticResource HexToBrush}}"
                                                  Stroke="#26000000" Visibility="Collapsed" Effect="{StaticResource Fb.CardShadow}" />
                                            <Image x:Name="Picture" Stretch="UniformToFill" Visibility="Collapsed" h:Behaviors.ClipRadius="{DynamicResource Fb.RadiusValue}"
                                                   Source="{Binding ImageFullPath, Converter={StaticResource ImagePath}, ConverterParameter=720}" />

                                            <!-- Freehand ink: drawn in its original box and scaled with the shape -->
                                            <Viewbox x:Name="InkBox" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False">
                                                <Canvas Width="{Binding InkWidth}" Height="{Binding InkHeight}">
                                                    <Path Data="{Binding PathData, Converter={StaticResource Geometry}}" Stroke="{Binding Fill, Converter={StaticResource HexToBrush}}"
                                                          StrokeThickness="{Binding StrokeWidth}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Frame / section -->
                                            <Grid x:Name="FrameBox" Visibility="Collapsed">
                                                <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Fill, Converter={StaticResource HexToBrush}}" Opacity="0.08" IsHitTestVisible="False" />
                                                <Rectangle RadiusX="10" RadiusY="10" Stroke="{Binding Fill, Converter={StaticResource HexToBrush}}" StrokeThickness="2" StrokeDashArray="5 3" />
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-30,0,0" Padding="10,3" CornerRadius="{DynamicResource Fb.RadiusSmall}"
                                                        Background="{Binding Fill, Converter={StaticResource HexToBrush}}" MinWidth="40">
                                                    <TextBlock Text="{Binding Text}" FontWeight="Bold" FontSize="13" Foreground="{Binding Fill, Converter={StaticResource ContrastBrush}}" />
                                                </Border>
                                            </Grid>

                                            <!-- Linked card -->
                                            <Border x:Name="CardBody" Visibility="Collapsed" Padding="12,10" CornerRadius="{DynamicResource Fb.Radius}"
                                                    Background="{DynamicResource Fb.CardBrush}" BorderThickness="1" BorderBrush="{DynamicResource Fb.CardBorderBrush}" Effect="{StaticResource Fb.CardShadow}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <ui:SymbolIcon Symbol="Board24" FontSize="12" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                                        <TextBlock Text="{Binding Card.Board.Name}" Style="{StaticResource Fb.Muted}" FontSize="11" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Card.Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border Style="{StaticResource Fb.Badge}" Background="{Binding Card.DueState, Converter={StaticResource DueStateToBrush}}"
                                                                Visibility="{Binding Card.HasDue, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Card.DueDate, Converter={StaticResource DateText}}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding Card.DueState, Converter={StaticResource DueStateToForeground}}" />
                                                        </Border>
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="14" Foreground="{DynamicResource Fb.SuccessBrush}" Margin="0,4,0,0"
                                                                       Visibility="{Binding Card.IsCompleted, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="The linked card was deleted" Style="{StaticResource Fb.Muted}" FontSize="12"
                                                               Visibility="{Binding IsCardMissing, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Text -->
                                            <TextBlock x:Name="Label" Text="{Binding Text}" FontSize="{Binding FontSize}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,6" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Fill, Converter={StaticResource ContrastBrush}}" IsHitTestVisible="False" />
                                            <TextBox x:Name="Editor" Style="{StaticResource Fb.BareTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="{Binding FontSize}"
                                                     FontWeight="SemiBold" TextAlignment="Center" AcceptsReturn="True" VerticalAlignment="Center" Margin="10,4" Tag="Type something"
                                                     Foreground="{Binding Fill, Converter={StaticResource ContrastBrush}}" CaretBrush="{Binding Fill, Converter={StaticResource ContrastBrush}}"
                                                     Visibility="Collapsed" Cursor="IBeam"
                                                     h:Behaviors.FocusWhen="{Binding IsEditing}" h:Behaviors.SelectAllOnFocus="True"
                                                     h:Behaviors.LostFocusCommand="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ActiveDocument.EndEditCommand}"
                                                     PreviewKeyDown="OnEditorKey" />

                                            <!-- Connection ports -->
                                            <Grid x:Name="Ports" Visibility="Hidden" Margin="-6">
                                                <Ellipse Style="{StaticResource Port}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                <Ellipse Style="{StaticResource Port}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <Ellipse Style="{StaticResource Port}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                <Ellipse Style="{StaticResource Port}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            </Grid>
                                            <!-- Resize handle -->
                                            <Border x:Name="Resize" Tag="resize" Width="12" Height="12" Margin="0,0,-8,-8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    CornerRadius="3" Background="{DynamicResource Fb.AccentBrush}" BorderBrush="White" BorderThickness="1.5" Cursor="SizeNWSE"
                                                    Visibility="Collapsed" ToolTip="Drag to resize (Shift keeps the proportions)" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="Rounded">
                                                <Setter TargetName="Body" Property="CornerRadius" Value="{DynamicResource Fb.RadiusLarge}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Ellipse">
                                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="EllipseShape" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Diamond">
                                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DiamondShape" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Label" Property="Margin" Value="28,6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Sticky">
                                                <Setter TargetName="Body" Property="CornerRadius" Value="2,2,18,2" />
                                                <Setter TargetName="Label" Property="VerticalAlignment" Value="Top" />
                                                <Setter TargetName="Label" Property="TextAlignment" Value="Left" />
                                                <Setter TargetName="Label" Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter TargetName="Label" Property="FontWeight" Value="Normal" />
                                                <Setter TargetName="Label" Property="Margin" Value="14,12" />
                                                <Setter TargetName="Editor" Property="VerticalAlignment" Value="Top" />
                                                <Setter TargetName="Editor" Property="TextAlignment" Value="Left" />
                                                <Setter TargetName="Editor" Property="Margin" Value="12,10" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Text">
                                                <Setter TargetName="Body" Property="Background" Value="Transparent" />
                                                <Setter TargetName="Body" Property="BorderThickness" Value="0" />
                                                <Setter TargetName="Body" Property="Effect" Value="{x:Null}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
                                                <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="Editor" Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
                                                <Setter TargetName="Editor" Property="CaretBrush" Value="{DynamicResource Fb.TextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Image">
                                                <Setter TargetName="Body" Property="Background" Value="{DynamicResource Fb.SubtleBrush}" />
                                                <Setter TargetName="Body" Property="CornerRadius" Value="{DynamicResource Fb.Radius}" />
                                                <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Ink">
                                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="InkBox" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Ports" Property="Opacity" Value="0" />
                                                <Setter TargetName="Ports" Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Frame">
                                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="FrameBox" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="NodeRoot" Property="Background" Value="{x:Null}" />
                                                <Setter TargetName="Ports" Property="Opacity" Value="0" />
                                                <Setter TargetName="Ports" Property="IsHitTestVisible" Value="False" />
                                                <Setter TargetName="Editor" Property="VerticalAlignment" Value="Top" />
                                                <Setter TargetName="Editor" Property="HorizontalAlignment" Value="Left" />
                                                <Setter TargetName="Editor" Property="Margin" Value="10,-28,0,0" />
                                                <Setter TargetName="Editor" Property="MinWidth" Value="120" />
                                                <Setter TargetName="Editor" Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
                                                <Setter TargetName="Editor" Property="Background" Value="{DynamicResource Fb.SurfaceBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Shape}" Value="Card">
                                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="CardBody" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <Trigger SourceName="NodeRoot" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ports" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Resize" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="Editor" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Label" Property="Visibility" Value="Hidden" />
                                                <Setter TargetName="Ports" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pen stroke being drawn -->
                            <Polyline x:Name="PenPreview" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Visibility="Collapsed" />
                            <!-- Connector being dragged -->
                            <Path x:Name="ConnectPreview" Stroke="{DynamicResource Fb.AccentBrush}" StrokeThickness="2" StrokeDashArray="4 3" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Canvas>
                    </Canvas>
                    <!-- Marquee selection (screen space) -->
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="Marquee" Visibility="Collapsed" Stroke="{DynamicResource Fb.AccentBrush}" StrokeThickness="1" Fill="{DynamicResource Fb.AccentSoftBrush}"
                                   RadiusX="4" RadiusY="4" />
                    </Canvas>
                </Grid>
            </Border>

            <!-- Empty hint -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Flowchart24" FontSize="44" Foreground="{DynamicResource Fb.FaintTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Double-click anywhere to add a shape" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Fb.MutedTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Text="or pick a tool on the left, paste an image, or drop files here" Style="{StaticResource Fb.Muted}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ============ Tools (left) ============ -->
            <Border Style="{StaticResource Fb.Glass}" Background="{DynamicResource Fb.SurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Padding="5"
                    Effect="{StaticResource Fb.PopupShadow}">
                <StackPanel>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Select and move (V)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Select}">
                        <ui:SymbolIcon Symbol="Cursor24" FontSize="18" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Rounded box (R)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Rounded}">
                        <Border Width="18" Height="13" CornerRadius="4" BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Rectangle (B)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Rectangle}">
                        <Border Width="18" Height="13" BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Ellipse / start–end (O)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Ellipse}">
                        <Ellipse Width="18" Height="14" StrokeThickness="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Decision diamond (D)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Diamond}">
                        <Path Data="M 9,0 L 18,8 L 9,16 L 0,8 Z" StrokeThickness="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Sticky note (S)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Sticky}">
                        <ui:SymbolIcon Symbol="Note24" FontSize="18" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Text (T)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Text}">
                        <ui:SymbolIcon Symbol="TextT24" FontSize="18" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Connector: drag from one shape to another (C)" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Connector}">
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="18" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Line (L) — drag anywhere; ends stick to shapes" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Line}">
                        <Path Data="M 1,15 L 17,1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Arrow (A) — drag anywhere; ends stick to shapes" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Arrow}">
                        <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="18" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Pen (P) — draw freehand" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Pen}">
                        <ui:SymbolIcon Symbol="Pen24" FontSize="18" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" GroupName="CvTool" ToolTip="Section / frame (F) — drag to draw an area that groups shapes" IsChecked="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Frame}">
                        <ui:SymbolIcon Symbol="GroupList24" FontSize="18" />
                    </RadioButton>
                    <Border Height="1" Background="{DynamicResource Fb.DividerBrush}" Margin="4,4" />
                    <Button Style="{StaticResource BarButton}" Width="38" Height="38" Command="{Binding AddImageCommand}" ToolTip="Add an image (I) — or paste / drop one">
                        <ui:SymbolIcon Symbol="Image24" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Width="38" Height="38" Command="{Binding AddCardCommand}" ToolTip="Add a card from a board">
                        <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="18" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============ Pen options (top, while drawing) ============ -->
            <Border Style="{StaticResource Fb.Glass}" Background="{DynamicResource Fb.SurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="8,5"
                    Effect="{StaticResource Fb.PopupShadow}" Panel.ZIndex="2" Visibility="{Binding Tool, Converter={StaticResource Equals}, ConverterParameter=Pen}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Pen24" FontSize="15" Margin="2,0,8,0" />
                    <ItemsControl ItemsSource="{Binding Fills}" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Fb.SwatchButton}" Width="20" Height="20" Margin="2,0" Focusable="False"
                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                        Command="{Binding DataContext.SetPenColorCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource SelectedTag}">
                                            <Binding />
                                            <Binding Path="DataContext.PenColor" ElementName="Root" />
                                        </MultiBinding>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:ColorButton Width="20" Height="20" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding SetPenColorCommand}" />
                    <Border Width="1" Height="20" Background="{DynamicResource Fb.DividerBrush}" Margin="8,0" />
                    <Button Style="{StaticResource BarButton}" ToolTip="Fine" Command="{Binding SetPenSizeCommand}" CommandParameter="2">
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Fb.TextBrush}" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTip="Medium" Command="{Binding SetPenSizeCommand}" CommandParameter="4">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Fb.TextBrush}" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTip="Thick" Command="{Binding SetPenSizeCommand}" CommandParameter="8">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource Fb.TextBrush}" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" ToolTip="Marker" Command="{Binding SetPenSizeCommand}" CommandParameter="16">
                        <Ellipse Width="17" Height="17" Fill="{DynamicResource Fb.TextBrush}" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============ Selection toolbar (top) ============ -->
            <Border Style="{StaticResource Fb.Glass}" Background="{DynamicResource Fb.SurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="6,4"
                    Effect="{StaticResource Fb.PopupShadow}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" h:Behaviors.AnimateIn="rise">
                <StackPanel Orientation="Horizontal">
                    <!-- Shapes -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasNodeSelection, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Fills}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Fb.SwatchButton}" Width="20" Height="20" Margin="2,0" Focusable="False"
                                            Background="{Binding Converter={StaticResource HexToBrush}}" ToolTip="{Binding}"
                                            Command="{Binding DataContext.SetFillCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <c:ColorButton Width="20" Height="20" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding SetFillCommand}" />
                        <Border Width="1" Height="20" Background="{DynamicResource Fb.DividerBrush}" Margin="6,0" />
                        <Button Style="{StaticResource BarButton}" ToolTip="Rounded" Command="{Binding SetShapeCommand}" CommandParameter="{x:Static models:NodeShape.Rounded}">
                            <Border Width="16" Height="11" CornerRadius="3" BorderThickness="1.6" BorderBrush="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Rectangle" Command="{Binding SetShapeCommand}" CommandParameter="{x:Static models:NodeShape.Rectangle}">
                            <Border Width="16" Height="11" BorderThickness="1.6" BorderBrush="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Ellipse" Command="{Binding SetShapeCommand}" CommandParameter="{x:Static models:NodeShape.Ellipse}">
                            <Ellipse Width="16" Height="12" StrokeThickness="1.6" Stroke="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Diamond" Command="{Binding SetShapeCommand}" CommandParameter="{x:Static models:NodeShape.Diamond}">
                            <Path Data="M 8,0 L 16,7 L 8,14 L 0,7 Z" StrokeThickness="1.6" Stroke="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Sticky" Command="{Binding SetShapeCommand}" CommandParameter="{x:Static models:NodeShape.Sticky}">
                            <ui:SymbolIcon Symbol="Note24" FontSize="15" />
                        </Button>
                        <Border Width="1" Height="20" Background="{DynamicResource Fb.DividerBrush}" Margin="6,0" />
                        <Button Style="{StaticResource BarButton}" ToolTip="Smaller text" Command="{Binding ChangeFontSizeCommand}" CommandParameter="-2">
                            <ui:SymbolIcon Symbol="TextFontSize24" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Bigger text" Command="{Binding ChangeFontSizeCommand}" CommandParameter="2">
                            <ui:SymbolIcon Symbol="TextFontSize24" FontSize="18" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Add connected child (Tab)" Command="{Binding AddChildCommand}">
                            <ui:SymbolIcon Symbol="BranchFork24" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Align &amp; distribute (select 2 or more)" h:Behaviors.ClickOpensContextMenu="True">
                            <ui:SymbolIcon Symbol="AlignLeft24" FontSize="16" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Align left" Command="{Binding AlignCommand}" CommandParameter="left">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignLeft24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Align centers" Command="{Binding AlignCommand}" CommandParameter="center">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignCenterHorizontal24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Align right" Command="{Binding AlignCommand}" CommandParameter="right">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignRight24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Align top" Command="{Binding AlignCommand}" CommandParameter="top">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignTop24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Align middles" Command="{Binding AlignCommand}" CommandParameter="middle">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignCenterVertical24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Align bottom" Command="{Binding AlignCommand}" CommandParameter="bottom">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignBottom24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Distribute horizontally" Command="{Binding DistributeCommand}" CommandParameter="h">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignSpaceEvenlyHorizontal20" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Distribute vertically" Command="{Binding DistributeCommand}" CommandParameter="v">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="AlignSpaceEvenlyVertical20" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Same size as the first" Command="{Binding MatchSizeCommand}">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Resize24" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Bring to front" Command="{Binding BringToFrontCommand}" />
                                    <MenuItem Header="Send to back" Command="{Binding SendToBackCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <!-- Connectors -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasEdgeSelection, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource BarButton}" ToolTip="Curved" Command="{Binding SetEdgeStyleCommand}" CommandParameter="{x:Static models:EdgeStyle.Curved}">
                            <Path Data="M 0,12 C 8,12 8,2 16,2" StrokeThickness="1.8" Stroke="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Straight" Command="{Binding SetEdgeStyleCommand}" CommandParameter="{x:Static models:EdgeStyle.Straight}">
                            <Path Data="M 0,12 L 16,2" StrokeThickness="1.8" Stroke="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Elbow" Command="{Binding SetEdgeStyleCommand}" CommandParameter="{x:Static models:EdgeStyle.Elbow}">
                            <Path Data="M 0,12 L 8,12 L 8,2 L 16,2" StrokeThickness="1.8" Stroke="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Dashed / solid" Command="{Binding ToggleDashedCommand}">
                            <Path Data="M 0,7 L 16,7" StrokeThickness="2" StrokeDashArray="2 1.5" Stroke="{DynamicResource Fb.TextBrush}" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Arrow at the end on / off" Command="{Binding ToggleArrowCommand}">
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Arrow at the start on / off (double-headed)" Command="{Binding ToggleStartArrowCommand}">
                            <ui:SymbolIcon Symbol="ArrowBidirectionalLeftRight24" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Line thickness" h:Behaviors.ClickOpensContextMenu="True">
                            <ui:SymbolIcon Symbol="LineThickness24" FontSize="15" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Thin" Command="{Binding SetThicknessCommand}" CommandParameter="1.5" />
                                    <MenuItem Header="Regular" Command="{Binding SetThicknessCommand}" CommandParameter="2.5" />
                                    <MenuItem Header="Bold" Command="{Binding SetThicknessCommand}" CommandParameter="4" />
                                    <MenuItem Header="Heavy" Command="{Binding SetThicknessCommand}" CommandParameter="7" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Reverse direction" Command="{Binding ReverseEdgeCommand}">
                            <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Label (double-click the line)" Command="{Binding EditEdgeLabelCommand}">
                            <ui:SymbolIcon Symbol="TextT24" FontSize="15" />
                        </Button>
                        <ItemsControl ItemsSource="{Binding EdgeColors}" Focusable="False" VerticalAlignment="Center" Margin="4,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Fb.SwatchButton}" Width="18" Height="18" Margin="2,0" Focusable="False"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.SetEdgeColorCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <c:ColorButton Width="18" Height="18" Margin="3,0,0,0" VerticalAlignment="Center" Command="{Binding SetEdgeColorCommand}" />
                    </StackPanel>
                    <Border Width="1" Height="20" Background="{DynamicResource Fb.DividerBrush}" Margin="6,0" />
                    <Button Style="{StaticResource BarButton}" ToolTip="Delete (Del)" Command="{Binding DeleteSelectionCommand}">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- ============ Zoom (bottom right) ============ -->
            <Border Style="{StaticResource Fb.Glass}" Background="{DynamicResource Fb.SurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Padding="4"
                    Effect="{StaticResource Fb.PopupShadow}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BarButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl + wheel)">
                        <ui:SymbolIcon Symbol="ZoomOut24" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource Fb.GhostButton}" Focusable="False" Padding="6,4" MinWidth="52" Command="{Binding ResetZoomCommand}" ToolTip="Reset to 100%">
                        <TextBlock Text="{Binding ZoomText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in">
                        <ui:SymbolIcon Symbol="ZoomIn24" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Command="{Binding ZoomToFitCommand}" ToolTip="Zoom to fit (Ctrl+0)">
                        <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="15" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
