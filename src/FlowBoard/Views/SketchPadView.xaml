<UserControl x:Class="FlowBoard.Views.SketchPadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:SketchPadViewModel}">
    <Border Style="{StaticResource Fb.Dialog}" MaxWidth="1100" Margin="40,30" Padding="18" VerticalAlignment="Center">
        <DockPanel>
            <!-- Title -->
            <Grid DockPanel.Dock="Top" Margin="4,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Pen24" FontSize="18" Foreground="{DynamicResource Fb.AccentTextBrush}" />
                    <TextBlock Style="{StaticResource Fb.DialogTitle}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="Sketch" /> <Run Text="{Binding Shot.Number, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource Fb.IconButton}" HorizontalAlignment="Right" Command="{Binding CloseCommand}" ToolTip="Close without saving">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </Button>
            </Grid>

            <!-- Tools -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Colors}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Fb.SwatchButton}" Width="26" Height="26" Margin="0,0,5,0"
                                    Background="{Binding Converter={StaticResource HexToBrush}}"
                                    Command="{Binding DataContext.SetColorCommand, ElementName=Root}" CommandParameter="{Binding}">
                                <Button.Tag>
                                    <MultiBinding Converter="{StaticResource SelectedTag}">
                                        <Binding />
                                        <Binding Path="DataContext.PenColor" ElementName="Root" />
                                    </MultiBinding>
                                </Button.Tag>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="1" Height="22" Background="{DynamicResource Fb.DividerBrush}" Margin="8,0" />
                <Border Style="{StaticResource Fb.SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Fb.Segment}" GroupName="PenSize" ToolTip="Fine" IsChecked="{Binding PenSize, Converter={StaticResource Equals}, ConverterParameter=2, Mode=OneWay}"
                                     Command="{Binding SetSizeCommand}" CommandParameter="2">
                            <Ellipse Width="4" Height="4" Fill="{DynamicResource Fb.TextBrush}" Margin="4,0" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource Fb.Segment}" GroupName="PenSize" ToolTip="Medium" IsChecked="{Binding PenSize, Converter={StaticResource Equals}, ConverterParameter=4, Mode=OneWay}"
                                     Command="{Binding SetSizeCommand}" CommandParameter="4">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Fb.TextBrush}" Margin="2,0" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource Fb.Segment}" GroupName="PenSize" ToolTip="Thick" IsChecked="{Binding PenSize, Converter={StaticResource Equals}, ConverterParameter=9, Mode=OneWay}"
                                     Command="{Binding SetSizeCommand}" CommandParameter="9">
                            <Ellipse Width="13" Height="13" Fill="{DynamicResource Fb.TextBrush}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource Fb.Segment}" GroupName="PenSize" ToolTip="Marker" IsChecked="{Binding PenSize, Converter={StaticResource Equals}, ConverterParameter=20, Mode=OneWay}"
                                     Command="{Binding SetSizeCommand}" CommandParameter="20">
                            <Ellipse Width="18" Height="18" Fill="{DynamicResource Fb.TextBrush}" />
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border Width="1" Height="22" Background="{DynamicResource Fb.DividerBrush}" Margin="8,0" />
                <ToggleButton Style="{StaticResource Fb.HeaderToggle}" IsChecked="{Binding IsHighlighter}" ToolTip="Highlighter (see-through strokes)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Highlight24" FontSize="15" />
                        <TextBlock Text="Highlighter" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Fb.HeaderToggle}" IsChecked="{Binding IsEraser}" ToolTip="Eraser">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Eraser24" FontSize="15" />
                        <TextBlock Text="Eraser" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Fb.HeaderToggle}" IsChecked="{Binding ShowGuides}" ToolTip="Rule-of-thirds guides (not saved)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Grid24" FontSize="15" />
                        <TextBlock Text="Guides" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Fb.HeaderToggle}" IsChecked="{Binding ShowBackground}" ToolTip="Draw over the frame's image"
                              Visibility="{Binding BackgroundPath, Converter={StaticResource HasValueToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Image24" FontSize="15" />
                        <TextBlock Text="Photo" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Border Width="1" Height="22" Background="{DynamicResource Fb.DividerBrush}" Margin="8,0" />
                <Button Style="{StaticResource Fb.IconButton}" Command="{Binding UndoStrokeCommand}" ToolTip="Undo last stroke (Ctrl+Z)">
                    <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource Fb.IconButton}" Command="{Binding ClearAllCommand}" ToolTip="Clear the drawing">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                </Button>
            </WrapPanel>

            <!-- Footer -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <TextBlock Text="Tip: use a pen or tablet for pressure-sensitive lines." Style="{StaticResource Fb.Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Style="{StaticResource Fb.SubtleButton}" Content="Cancel" Command="{Binding CloseCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Fb.AccentButton}" Click="OnSave">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="15" />
                        <TextBlock Text="Save frame" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Drawing surface: fixed 16:9 page, scaled to fit -->
            <Border CornerRadius="{DynamicResource Fb.Radius}" BorderThickness="1" BorderBrush="{DynamicResource Fb.DividerBrush}" ClipToBounds="True">
                <Viewbox Stretch="Uniform" MaxHeight="620">
                    <Grid x:Name="Surface" Width="960" Height="540" Background="White" ClipToBounds="True">
                        <Image Source="{Binding BackgroundFullPath, Converter={StaticResource ImagePath}, ConverterParameter=1920}" Stretch="UniformToFill"
                               Visibility="{Binding ShowBackground, Converter={StaticResource BoolToVis}}" />
                        <InkCanvas x:Name="Ink" Background="Transparent" Strokes="{Binding Strokes, Mode=OneTime}" UseCustomCursor="True" Cursor="Pen" />
                        <Grid x:Name="Guides" IsHitTestVisible="False" Visibility="{Binding ShowGuides, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Grid.RowSpan="3" Grid.Column="1" BorderBrush="#4D8B5CF6" BorderThickness="1,0" />
                            <Border Grid.ColumnSpan="3" Grid.Row="1" BorderBrush="#4D8B5CF6" BorderThickness="0,1" />
                            <Border Grid.RowSpan="3" Grid.ColumnSpan="3" BorderBrush="#338B5CF6" BorderThickness="48,27" Opacity="0.35" />
                        </Grid>
                    </Grid>
                </Viewbox>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
