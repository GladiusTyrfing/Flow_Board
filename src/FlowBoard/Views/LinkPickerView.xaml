<UserControl x:Class="FlowBoard.Views.LinkPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LinkPickerViewModel}">
    <Border Style="{StaticResource Fb.Dialog}" Width="600" VerticalAlignment="Top" Margin="0,80,0,0" Padding="0">
        <DockPanel MaxHeight="520">
            <StackPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Fb.Caption}" Margin="0,0,0,8" />
                <Grid>
                    <ui:SymbolIcon Symbol="Link24" FontSize="18" HorizontalAlignment="Left" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                    <TextBox x:Name="QueryBox" Style="{StaticResource Fb.BareTextBox}" Margin="28,0,0,0" FontSize="16" TextWrapping="NoWrap"
                             Tag="{Binding Placeholder}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="QueryBox_PreviewKeyDown" h:Behaviors.FocusOnLoad="True" />
                </Grid>
            </StackPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Fb.DividerBrush}" />
            <TextBlock DockPanel.Dock="Bottom" Margin="18,8" Style="{StaticResource Fb.Muted}" Text="↑ ↓ to move · Enter to link · Esc to cancel" />
            <Grid>
                <TextBlock Text="Nothing found" Style="{StaticResource Fb.Muted}" HorizontalAlignment="Center" Margin="0,30"
                           Visibility="{Binding Results.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                <ListBox x:Name="Results" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                         Margin="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="Results_MouseLeftButtonUp"
                         SelectionChanged="Results_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LinkOption}">
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.SubtleBrush}" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Foreground="{DynamicResource Fb.TextBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Fb.Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Group}" Style="{StaticResource Fb.Caption}" Margin="10,0,4,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
