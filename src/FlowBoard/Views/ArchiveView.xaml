<UserControl x:Class="FlowBoard.Views.ArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:models="clr-namespace:FlowBoard.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ArchiveViewModel}">
    <Border Style="{StaticResource Fb.Dialog}" Width="560" Margin="0,24" Padding="24">
        <DockPanel MaxHeight="620">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Archive24" FontSize="22" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                    <TextBlock Text="Archived items" Style="{StaticResource Fb.DialogTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Fb.IconButton}" HorizontalAlignment="Right" Command="{Binding CloseCommand}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </Button>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Style="{StaticResource Fb.Segment}" GroupName="ArTab" IsChecked="{Binding ShowLists, Converter={StaticResource InverseBool}}"
                             Content="{Binding Board.ArchivedCards.Count}" ContentStringFormat="Cards ({0})" />
                <RadioButton Style="{StaticResource Fb.Segment}" GroupName="ArTab" IsChecked="{Binding ShowLists}"
                             Content="{Binding Board.ArchivedLists.Count}" ContentStringFormat="Lists ({0})" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Visibility="{Binding ShowLists, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="No archived cards." Style="{StaticResource Fb.Muted}" FontSize="13"
                                   Visibility="{Binding Board.ArchivedCards.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Board.ArchivedCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Card}">
                                    <Border CornerRadius="{DynamicResource Fb.Radius}" Padding="12,8" Margin="0,0,0,6" Background="{DynamicResource Fb.CardBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                                <TextBlock Text="{Binding ArchivedAt, Converter={StaticResource RelativeTime}, StringFormat='Archived {0}'}" Style="{StaticResource Fb.Muted}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource Fb.SubtleButton}" Content="Open" Margin="0,0,6,0"
                                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenCardCommand}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Fb.SubtleButton}" Content="Restore" Margin="0,0,6,0"
                                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RestoreCardCommand}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Fb.IconButton}" ToolTip="Delete permanently"
                                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteArchivedCardCommand}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowLists, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No archived lists." Style="{StaticResource Fb.Muted}" FontSize="13"
                                   Visibility="{Binding Board.ArchivedLists.Count, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Board.ArchivedLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BoardList}">
                                    <Border CornerRadius="{DynamicResource Fb.Radius}" Padding="12,8" Margin="0,0,0,6" Background="{DynamicResource Fb.CardBrush}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Fb.TextBrush}" />
                                                <TextBlock Text="{Binding Cards.Count, StringFormat='{}{0} cards'}" Style="{StaticResource Fb.Muted}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource Fb.SubtleButton}" Content="Restore" Margin="0,0,6,0"
                                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RestoreListCommand}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Fb.IconButton}" ToolTip="Delete permanently"
                                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteListCommand}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
