<UserControl x:Class="FlowBoard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Fb.Text}">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- Click, then press a key combination -->
        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource Fb.Input}">
            <Setter Property="Width" Value="200" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="ToolTip" Value="Click, then press the new key combination. Backspace clears it." />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Fb.Dialog}" Width="720" Margin="0,24">
        <DockPanel MaxHeight="760">
            <Grid DockPanel.Dock="Top" Margin="24,20,20,10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="22" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Settings" Style="{StaticResource Fb.DialogTitle}" Margin="10,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Fb.IconButton}" HorizontalAlignment="Right" Command="{Binding CloseCommand}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </Button>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,20">
                <StackPanel>

                    <!-- Appearance -->
                    <TextBlock Text="APPEARANCE" Style="{StaticResource Fb.Caption}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Fb.Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Theme" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Theme" Content="Dark"
                                                 IsChecked="{Binding Settings.Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Theme" Content="Light"
                                                 IsChecked="{Binding Settings.Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Theme" Content="Follow Windows"
                                                 IsChecked="{Binding Settings.Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="Window material" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Mica and Acrylic need Windows 11." Style="{StaticResource Fb.Muted}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Backdrop" Content="Mica"
                                                 IsChecked="{Binding Settings.Backdrop, Converter={StaticResource Equals}, ConverterParameter=Mica}" />
                                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Backdrop" Content="Acrylic"
                                                 IsChecked="{Binding Settings.Backdrop, Converter={StaticResource Equals}, ConverterParameter=Acrylic}" />
                                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Backdrop" Content="Tabbed"
                                                 IsChecked="{Binding Settings.Backdrop, Converter={StaticResource Equals}, ConverterParameter=Tabbed}" />
                                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="Backdrop" Content="Solid"
                                                 IsChecked="{Binding Settings.Backdrop, Converter={StaticResource Equals}, ConverterParameter=None}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Accent color" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Style="{StaticResource Fb.SubtleButton}" Content="Windows accent" Margin="0,0,8,6" Padding="10,5"
                                        Command="{Binding SetAccentCommand}" CommandParameter="{x:Null}" />
                                <ItemsControl ItemsSource="{Binding AccentColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Fb.SwatchButton}" Width="30" Height="30" Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.SetAccentCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <Grid Style="{StaticResource Row}" Margin="0,8,0,0">
                                <TextBlock Text="Animations" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.Animations}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- General -->
                    <TextBlock Text="GENERAL" Style="{StaticResource Fb.Caption}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Fb.Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="Your name" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Shown on comments and activity." Style="{StaticResource Fb.Muted}" />
                                </StackPanel>
                                <ui:TextBox Width="220" HorizontalAlignment="Right" Text="{Binding Settings.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="Keep running in the tray when closed" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Reminders, global hotkeys and the focus timer keep working." Style="{StaticResource Fb.Muted}" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.MinimizeToTray}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.StartWithWindows}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Start minimized" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.StartMinimized}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Hotkeys -->
                    <TextBlock Text="HOTKEYS" Style="{StaticResource Fb.Caption}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Fb.Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="Global hotkeys" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Work from any app, even when FlowBoard is hidden in the tray." Style="{StaticResource Fb.Muted}" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.GlobalHotkeysEnabled}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" IsEnabled="{Binding Settings.GlobalHotkeysEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Quick add a card" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Pops up a capture box over whatever you're doing." Style="{StaticResource Fb.Muted}" />
                                </StackPanel>
                                <TextBox Style="{StaticResource HotkeyBox}" HorizontalAlignment="Right" Tag="QuickAdd"
                                         Text="{Binding Settings.QuickAddHotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            </Grid>
                            <Grid Style="{StaticResource Row}" IsEnabled="{Binding Settings.GlobalHotkeysEnabled}">
                                <TextBlock Text="Show / hide FlowBoard" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource HotkeyBox}" HorizontalAlignment="Right" Tag="ShowHide"
                                         Text="{Binding Settings.ShowHideHotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="Card hover hotkeys" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Hover a card and press X, C, P, T, 1–9, Alt+arrows… (see F1)" Style="{StaticResource Fb.Muted}" />
                                </StackPanel>
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.CardHoverHotkeys}" />
                            </Grid>
                            <Button Style="{StaticResource Fb.SubtleButton}" HorizontalAlignment="Left" Command="{Binding Main.OpenShortcutsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="14" />
                                    <TextBlock Text="Show all shortcuts (F1)" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <TextBlock Text="REMINDERS" Style="{StaticResource Fb.Caption}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Fb.Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Due date reminders" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.RemindersEnabled}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Play sounds" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.PlaySounds}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Default reminder for new due dates (minutes before, -1 = none)" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ComboBox Width="120" HorizontalAlignment="Right" ItemsSource="{Binding ReminderDefaults}" SelectedItem="{Binding Settings.DefaultReminderMinutes}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Pomodoro -->
                    <TextBlock Text="FOCUS TIMER" Style="{StaticResource Fb.Caption}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Fb.Section}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Focus minutes" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:NumberBox Width="140" HorizontalAlignment="Right" Minimum="1" Maximum="180" SmallChange="5" MaxDecimalPlaces="0"
                                              Value="{Binding Settings.PomodoroFocusMinutes, Converter={StaticResource IntToDouble}}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Short break minutes" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:NumberBox Width="140" HorizontalAlignment="Right" Minimum="1" Maximum="60" MaxDecimalPlaces="0"
                                              Value="{Binding Settings.PomodoroShortBreakMinutes, Converter={StaticResource IntToDouble}}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Long break minutes" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:NumberBox Width="140" HorizontalAlignment="Right" Minimum="1" Maximum="90" MaxDecimalPlaces="0"
                                              Value="{Binding Settings.PomodoroLongBreakMinutes, Converter={StaticResource IntToDouble}}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Focus sessions before a long break" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:NumberBox Width="140" HorizontalAlignment="Right" Minimum="1" Maximum="12" MaxDecimalPlaces="0"
                                              Value="{Binding Settings.PomodoroSessionsBeforeLongBreak, Converter={StaticResource IntToDouble}}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Start breaks automatically" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.PomodoroAutoStartBreaks}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Start the next focus session automatically" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.PomodoroAutoStartFocus}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Data -->
                    <TextBlock Text="DATA" Style="{StaticResource Fb.Caption}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Fb.Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Fb.Muted}" FontSize="13" TextWrapping="Wrap">
                                <Run Text="Everything is stored locally in" />
                                <Run Text="{Binding DataDir, Mode=OneWay}" FontFamily="Consolas" Foreground="{DynamicResource Fb.TextBrush}" />
                                <Run Text=". FlowBoard saves automatically every couple of seconds and keeps rolling daily backups. Put a file named portable.txt next to FlowBoard.exe to keep data beside the app instead." />
                            </TextBlock>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource Fb.SubtleButton}" Margin="0,0,8,8" Content="Open data folder" Command="{Binding Main.OpenDataFolderCommand}" />
                                <Button Style="{StaticResource Fb.SubtleButton}" Margin="0,0,8,8" Content="Back up to zip…" Command="{Binding Main.BackupNowCommand}" />
                                <Button Style="{StaticResource Fb.SubtleButton}" Margin="0,0,8,8" Content="Restore from zip…" Command="{Binding Main.RestoreBackupCommand}" />
                                <Button Style="{StaticResource Fb.SubtleButton}" Margin="0,0,8,8" Content="Export current board…" Command="{Binding Main.ExportBoardCommand}" />
                                <Button Style="{StaticResource Fb.SubtleButton}" Margin="0,0,8,8" Content="Import board…" Command="{Binding Main.ImportBoardCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource Fb.Muted}" Margin="0,6,0,0">
                        <Run Text="FlowBoard" FontWeight="SemiBold" /> <Run Text="{Binding Version, Mode=OneWay}" />
                        <Run Text="· a local-first task board" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
