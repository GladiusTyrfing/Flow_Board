<UserControl x:Class="FlowBoard.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:models="clr-namespace:FlowBoard.Models"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <UserControl.Resources>
        <!-- ================= Card (front) ================= -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type models:Card}">
            <Border x:Name="CardRoot" Margin="2,0,2,10" CornerRadius="14" Background="{DynamicResource Fb.CardBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource Fb.CardBorderBrush}" Cursor="Hand"
                    Effect="{StaticResource Fb.CardShadow}" h:Behaviors.AnimateIn="fade"
                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" MouseLeftButtonUp="Card_MouseLeftButtonUp"
                    MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave"
                    Visibility="{Binding IsFilteredOut, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open card" FontWeight="SemiBold" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenCardCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Mark complete / incomplete" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleCompleteCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="CheckmarkCircle24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Priority">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Flag24" /></MenuItem.Icon>
                            <MenuItem Header="Urgent" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetCardPriorityCommand}">
                                <MenuItem.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ToArray}">
                                        <Binding />
                                        <Binding Source="{x:Static models:Priority.Urgent}" />
                                    </MultiBinding>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="High" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetCardPriorityCommand}">
                                <MenuItem.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ToArray}">
                                        <Binding />
                                        <Binding Source="{x:Static models:Priority.High}" />
                                    </MultiBinding>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="Medium" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetCardPriorityCommand}">
                                <MenuItem.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ToArray}">
                                        <Binding />
                                        <Binding Source="{x:Static models:Priority.Medium}" />
                                    </MultiBinding>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="Low" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetCardPriorityCommand}">
                                <MenuItem.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ToArray}">
                                        <Binding />
                                        <Binding Source="{x:Static models:Priority.Low}" />
                                    </MultiBinding>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="None" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetCardPriorityCommand}">
                                <MenuItem.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ToArray}">
                                        <Binding />
                                        <Binding Source="{x:Static models:Priority.None}" />
                                    </MultiBinding>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Start / stop timer" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleCardTimerCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Timer24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Duplicate" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DuplicateCardCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Archive" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ArchiveCardCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Archive24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Delete…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteCardCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel>
                    <!-- Image cover -->
                    <Border Height="150" CornerRadius="13,13,0,0"
                            Visibility="{Binding CoverImagePath, Converter={StaticResource HasValueToVis}}">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding CoverImagePath, Converter={StaticResource ImagePath}, ConverterParameter=600}" />
                        </Border.Background>
                    </Border>
                    <!-- Color cover -->
                    <Border Height="34" CornerRadius="13,13,0,0" Background="{Binding CoverColor, Converter={StaticResource HexToBrush}}"
                            Visibility="{Binding HasCoverColor, Converter={StaticResource BoolToVis}}" />

                    <Grid>
                    <!-- Priority edge -->
                    <Border Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="0,3,3,0"
                            Background="{Binding Priority, Converter={StaticResource PriorityToBrush}}" />
                    <StackPanel Margin="12,10,12,10">
                        <!-- Labels -->
                        <ItemsControl ItemsSource="{Binding ResolvedLabels}" Visibility="{Binding HasLabels, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Label}">
                                    <Border CornerRadius="999" MinWidth="36" Height="18" Padding="8,0" Margin="0,0,4,4"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}" ToolTip="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                                   Foreground="{Binding Color, Converter={StaticResource ContrastBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Complete + title -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="Check" Style="{StaticResource Fb.RoundCheck}" Margin="0,1,8,0" VerticalAlignment="Top" Visibility="Collapsed"
                                      IsChecked="{Binding IsCompleted, Mode=OneWay}" dd:DragDrop.DragSourceIgnore="True" ToolTip="Mark complete"
                                      Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleCompleteCommand}" CommandParameter="{Binding}" />
                            <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="14"
                                       Foreground="{DynamicResource Fb.TextBrush}" />
                        </Grid>

                        <!-- Badges -->
                        <WrapPanel Margin="0,2,0,0">
                            <Border x:Name="PrioBadge" Style="{StaticResource Fb.Badge}" Background="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                    ToolTip="Priority">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Flag24" Filled="True" FontSize="12" Foreground="#1D2125" />
                                    <TextBlock Text="{Binding Priority}" FontSize="11" FontWeight="SemiBold" Margin="3,0,0,0" Foreground="#1D2125" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Fb.Badge}" Background="{Binding DueState, Converter={StaticResource DueStateToBrush}}"
                                    Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}" ToolTip="Due date">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="{Binding DueState, Converter={StaticResource DueStateToForeground}}">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="12" Foreground="{Binding DueState, Converter={StaticResource DueStateToForeground}}" />
                                    <TextBlock Text="{Binding DueText}" FontSize="11" Margin="4,0,0,0" FontWeight="Medium" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Fb.Badge}" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" ToolTip="This card has a description">
                                <ui:SymbolIcon Symbol="TextDescription24" FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                            </Border>
                            <Border x:Name="ChecklistBadge" Style="{StaticResource Fb.Badge}" Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVis}}" ToolTip="Checklist items">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Fb.MutedTextBrush}">
                                    <ui:SymbolIcon x:Name="ChecklistIcon" Symbol="CheckboxChecked24" FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                    <TextBlock x:Name="ChecklistText" Text="{Binding ChecklistText}" FontSize="11" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Fb.Badge}" Visibility="{Binding FileCount, Converter={StaticResource HasValueToVis}}" ToolTip="Attachments">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Fb.MutedTextBrush}">
                                    <ui:SymbolIcon Symbol="Attach24" FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                    <TextBlock Text="{Binding FileCount}" FontSize="11" Margin="3,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Fb.Badge}" Visibility="{Binding VoiceCount, Converter={StaticResource HasValueToVis}}" ToolTip="Voice notes">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Fb.MutedTextBrush}">
                                    <ui:SymbolIcon Symbol="Mic24" FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                    <TextBlock Text="{Binding VoiceCount}" FontSize="11" Margin="3,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Fb.Badge}" Visibility="{Binding CommentCount, Converter={StaticResource HasValueToVis}}" ToolTip="Comments">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Fb.MutedTextBrush}">
                                    <ui:SymbolIcon Symbol="Comment24" FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                    <TextBlock Text="{Binding CommentCount}" FontSize="11" Margin="3,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="TimeBadge" Style="{StaticResource Fb.Badge}" ToolTip="Time tracked"
                                    Visibility="{Binding HasTrackedTime, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Fb.MutedTextBrush}">
                                    <ui:SymbolIcon Symbol="Timer24" FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                    <TextBlock Text="{Binding TrackedTimeText}" FontSize="11" Margin="3,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Fb.Badge}" Background="#33F87168" ToolTip="Timer running"
                                    Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#F87168" VerticalAlignment="Center" />
                                    <TextBlock Text="Tracking" FontSize="11" Margin="4,0,0,0" Foreground="#F87168" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-2" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.2" EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                    <Setter TargetName="CardRoot" Property="Effect" Value="{StaticResource Fb.CardHoverShadow}" />
                    <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource Fb.CardHoverBrush}" />
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource Fb.AccentBrush}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Title" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="None">
                    <Setter TargetName="PrioBadge" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecklistComplete}" Value="True">
                    <Setter TargetName="ChecklistBadge" Property="Background" Value="{DynamicResource Fb.SuccessBrush}" />
                    <Setter TargetName="ChecklistIcon" Property="Foreground" Value="{DynamicResource Fb.OnStatusBrush}" />
                    <Setter TargetName="ChecklistText" Property="Foreground" Value="{DynamicResource Fb.OnStatusBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource Fb.AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ================= List (column) ================= -->
        <DataTemplate x:Key="ListTemplate" DataType="{x:Type models:BoardList}">
            <Grid Margin="0,0,12,0" VerticalAlignment="Top">
                <!-- Expanded -->
                <Border x:Name="Expanded" Width="284" Background="{DynamicResource Fb.ListBrush}" CornerRadius="20" Padding="8,10,8,8"
                        BorderThickness="1" BorderBrush="{DynamicResource Fb.ListBorderBrush}"
                        VerticalAlignment="Top" h:Behaviors.AnimateIn="rise">
                    <DockPanel>
                        <!-- Colored accent strip -->
                        <Border DockPanel.Dock="Top" Height="4" CornerRadius="2" Margin="6,0,6,6"
                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}" />

                        <!-- Header -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Fb.GhostButton}" Padding="8,4" ToolTip="Click to rename · drag to move"
                                    Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=StartRenameListCommand}" CommandParameter="{Binding}"
                                    Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource Fb.AccentGradientBrush}" />
                                        <Ellipse Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                               Foreground="{DynamicResource Fb.ListHeaderTextBrush}" />
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="14" Margin="6,0,0,0" Foreground="{DynamicResource Fb.SuccessBrush}"
                                                   ToolTip="Cards moved here are marked complete"
                                                   Visibility="{Binding IsDoneList, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Button>
                            <TextBox Style="{StaticResource Fb.Input}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                                     h:Behaviors.FocusWhen="{Binding IsEditingName}" h:Behaviors.SelectAllOnFocus="True"
                                     h:Behaviors.EnterCommand="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CommitListNameCommand}"
                                     h:Behaviors.EscapeCommand="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CommitListNameCommand}"
                                     h:Behaviors.LostFocusCommand="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CommitListNameCommand}" />

                            <Border x:Name="CountBadge" Grid.Column="1" CornerRadius="999" Padding="7,1" Margin="4,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Fb.SubtleBrush}" ToolTip="Cards (and work-in-progress limit)">
                                <TextBlock x:Name="CountText" Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                            </Border>

                            <Button Grid.Column="2" Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="Collapse list"
                                    Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleCollapseListCommand}" CommandParameter="{Binding}">
                                <ui:SymbolIcon Symbol="ArrowCollapseAll24" FontSize="14" />
                            </Button>

                            <Button Grid.Column="3" Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="List actions"
                                    h:Behaviors.ClickOpensContextMenu="True">
                                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add card" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=StartAddCardCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Add24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Rename" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=StartRenameListCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Rename24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy list" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CopyListCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sort by">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSort24" /></MenuItem.Icon>
                                            <MenuItem Header="Due date" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SortListCommand}">
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="due" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Priority" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SortListCommand}">
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="priority" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Title (A–Z)" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SortListCommand}">
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="title" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Newest first" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SortListCommand}">
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="newest" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Oldest first" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SortListCommand}">
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="oldest" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                        </MenuItem>
                                        <MenuItem Header="List color">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Color24" /></MenuItem.Icon>
                                            <MenuItem Header="None" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetListColorCommand}">
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Green" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetListColorCommand}">
                                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#4BCE97" /></MenuItem.Icon>
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="#4BCE97" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Yellow" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetListColorCommand}">
                                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#F5CD47" /></MenuItem.Icon>
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="#F5CD47" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Orange" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetListColorCommand}">
                                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#FEA362" /></MenuItem.Icon>
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="#FEA362" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Red" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetListColorCommand}">
                                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#F87168" /></MenuItem.Icon>
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="#F87168" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Purple" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetListColorCommand}">
                                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#9F8FEF" /></MenuItem.Icon>
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="#9F8FEF" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                            <MenuItem Header="Blue" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetListColorCommand}">
                                                <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#579DFF" /></MenuItem.Icon>
                                                <MenuItem.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ToArray}">
                                                        <Binding />
                                                        <Binding Source="#579DFF" />
                                                    </MultiBinding>
                                                </MenuItem.CommandParameter>
                                            </MenuItem>
                                        </MenuItem>
                                        <MenuItem Header="Set WIP limit…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SetWipLimitCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Warning24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Completes cards moved here" IsCheckable="True" IsChecked="{Binding IsDoneList, Mode=OneWay}"
                                                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleDoneListCommand}" CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Archive all cards in this list" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ArchiveAllCardsCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Archive24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Archive list" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ArchiveListCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Archive24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Delete list…" Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteListCommand}" CommandParameter="{Binding}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <!-- Footer: add card -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,2,0,0">
                            <Grid Visibility="{Binding IsAddingCard, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Fb.GhostButton}" HorizontalAlignment="Stretch" Foreground="{DynamicResource Fb.MutedTextBrush}"
                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=StartAddCardCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                                        <TextBlock Text="Add a card" Margin="8,0,0,0" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel Visibility="{Binding IsAddingCard, Converter={StaticResource BoolToVis}}" Margin="2,0">
                                <TextBox Style="{StaticResource Fb.Input}" MinHeight="64" AcceptsReturn="True" Background="{DynamicResource Fb.CardBrush}"
                                         BorderBrush="{DynamicResource Fb.AccentBrush}"
                                         Text="{Binding NewCardTitle, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Enter to add · Shift+Enter for a new line (each line becomes a card) · Esc to cancel"
                                         h:Behaviors.FocusWhen="{Binding IsAddingCard}"
                                         h:Behaviors.EnterCommand="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CommitAddCardCommand}"
                                         h:Behaviors.EscapeCommand="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CancelAddCardCommand}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource Fb.AccentButton}" Content="Add card"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CommitAddCardCommand}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Fb.IconButton}" Margin="4,0,0,0" ToolTip="Cancel (Esc)"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CancelAddCardCommand}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Cards -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,2,4,0">
                            <ItemsControl ItemsSource="{Binding Cards}" MinHeight="14" Background="Transparent"
                                          ItemTemplate="{StaticResource CardTemplate}"
                                          dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                                          dd:DragDrop.DragDropContext="cards"
                                          dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DefaultDragAdornerOpacity="0.92"
                                          dd:DragDrop.DropHandler="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CardDropHandler}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Collapsed -->
                <Border x:Name="Collapsed" Width="48" MinHeight="200" Background="{DynamicResource Fb.ListBrush}" CornerRadius="20"
                        VerticalAlignment="Top" Visibility="Collapsed" BorderThickness="1" BorderBrush="{DynamicResource Fb.ListBorderBrush}">
                    <Button Style="{StaticResource Fb.GhostButton}" Padding="0,10" VerticalContentAlignment="Top" HorizontalContentAlignment="Center"
                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleCollapseListCommand}" CommandParameter="{Binding}"
                            ToolTip="Expand list">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="ArrowExpand24" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,10" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Fb.ListHeaderTextBrush}">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBlock Text="{Binding Cards.Count}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="Expanded" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Collapsed" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverWip}" Value="True">
                    <Setter TargetName="CountBadge" Property="Background" Value="{DynamicResource Fb.DangerBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource Fb.OnStatusBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="BoardScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Background="Transparent" Padding="12,12,12,6"
                  PreviewMouseWheel="BoardScroller_PreviewMouseWheel"
                  PreviewMouseLeftButtonDown="BoardScroller_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="BoardScroller_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="BoardScroller_PreviewMouseLeftButtonUp">
        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding CurrentBoard.Lists}" ItemTemplate="{StaticResource ListTemplate}" VerticalAlignment="Stretch"
                          dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DragDropContext="lists"
                          dd:DragDrop.UseDefaultDragAdorner="True" dd:DragDrop.DefaultDragAdornerOpacity="0.85"
                          dd:DragDrop.DropHandler="{Binding ListDropHandler}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Add another list -->
            <Grid Width="280" VerticalAlignment="Top">
                <Button Style="{StaticResource Fb.GhostButton}" Background="{DynamicResource Fb.HeaderBarBrush}" Foreground="{DynamicResource Fb.HeaderTextBrush}"
                        BorderBrush="{DynamicResource Fb.ListBorderBrush}" BorderThickness="1" Padding="16,13" h:Behaviors.CornerRadius="18"
                        Command="{Binding StartAddListCommand}"
                        Visibility="{Binding IsAddingList, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                        <TextBlock Text="Add another list" Margin="8,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Border Background="{DynamicResource Fb.ListBrush}" CornerRadius="20" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Fb.ListBorderBrush}"
                        Visibility="{Binding IsAddingList, Converter={StaticResource BoolToVis}}" h:Behaviors.AnimateIn="pop">
                    <StackPanel>
                        <ui:TextBox PlaceholderText="Enter list name…" Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}"
                                    h:Behaviors.FocusWhen="{Binding IsAddingList}"
                                    h:Behaviors.EnterCommand="{Binding CommitAddListCommand}"
                                    h:Behaviors.EscapeCommand="{Binding CancelAddListCommand}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Fb.AccentButton}" Content="Add list" Command="{Binding CommitAddListCommand}" />
                            <Button Style="{StaticResource Fb.IconButton}" Margin="4,0,0,0" Command="{Binding CancelAddListCommand}" ToolTip="Cancel (Esc)">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
