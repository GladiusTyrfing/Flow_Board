<UserControl x:Class="FlowBoard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FlowBoard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:services="clr-namespace:FlowBoard.Services"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Fb.Glass}">
            <Setter Property="Background" Value="{DynamicResource Fb.SurfaceBrush}" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,14,14" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ActionCard" TargetType="Button" BasedOn="{StaticResource Fb.SubtleButton}">
            <Setter Property="Width" Value="196" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="{DynamicResource Fb.PanelBrush}" />
            <Setter Property="h:Behaviors.CornerRadius" Value="{DynamicResource Fb.RadiusLarge}" />
        </Style>

        <DataTemplate x:Key="ProjectRow" DataType="{x:Type vm:RecentProject}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="Row" Style="{StaticResource Fb.GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,7"
                        Command="{Binding OpenRecentProjectCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}"
                        ToolTip="{Binding Path}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Badge" Width="32" Height="32" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.SubtleBrush}" Margin="0,0,10,0">
                            <ui:SymbolIcon x:Name="Icon" Symbol="Folder24" FontSize="16" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Fb.Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="When" Grid.Column="2" Text="{Binding Edited}" Style="{StaticResource Fb.Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,4,0" />
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="Show in Explorer"
                        Command="{Binding ShowProjectInExplorerCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="Remove from list (the files stay)"
                        Command="{Binding RemoveRecentProjectCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Icon" Property="Symbol" Value="FolderProhibited24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Fb.AccentGradientBrush}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="White" />
                    <Setter TargetName="When" Property="Text" Value="open now" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Fb.HeaderPill}" Margin="12,12,12,0" Padding="6,5">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Fb.HeaderButton}" Command="{Binding Main.ToggleSidebarCommand}" ToolTip="Show sidebar (Ctrl+B)"
                            Visibility="{Binding Main.IsSidebarShown, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" />
                    </Button>
                    <Border Width="30" Height="30" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.AccentGradientBrush}" Margin="4,0,8,0">
                        <ui:SymbolIcon Symbol="DataPie24" FontSize="16" Foreground="White" />
                    </Border>
                    <TextBlock Text="Home" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource Fb.DividerBrush}" Margin="12,0,6,0"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Fb.HeaderButton}" h:Behaviors.ClickOpensContextMenu="True" ToolTip="{Binding ProjectPath}"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="15" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                            <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Margin="6,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="New project…" Command="{Binding Main.NewProjectCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="FolderAdd24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open project…" InputGestureText="Ctrl+O" Command="{Binding Main.OpenProjectCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save a copy as…" Command="{Binding Main.SaveProjectCopyCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentCopy24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Back up to zip…" Command="{Binding Main.BackupNowCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Save24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Show in Explorer" Command="{Binding Main.ShowProjectInExplorerCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="FolderArrowRight24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Close project" Command="{Binding Main.CloseProjectCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Dismiss20" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource Fb.HeaderButton}" HorizontalAlignment="Right" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <Grid>
            <!-- ============ No project open: welcome ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0"
                          Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel MaxWidth="1040" Margin="12,40,12,24" HorizontalAlignment="Center">
                    <StackPanel h:Behaviors.AnimateIn="rise" Margin="0,0,0,26">
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource Fb.GradientTitle}" FontSize="36" />
                        <TextBlock Style="{StaticResource Fb.Muted}" FontSize="14.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Pick up a project or start a new one. Each project is a file on this PC with its boards, storyboards, canvases and pages inside." />
                    </StackPanel>

                    <WrapPanel>
                        <Button Style="{StaticResource ActionCard}" Command="{Binding Main.NewProjectCommand}" h:Behaviors.AnimateIn="pop">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.AccentGradientBrush}" HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="White" />
                                </Border>
                                <TextBlock Text="New project" FontWeight="Bold" FontSize="15" Margin="0,12,0,2" />
                                <TextBlock Text="Start empty in Documents\FlowBoard Projects" Style="{StaticResource Fb.Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Command="{Binding Main.OpenProjectCommand}" h:Behaviors.AnimateIn="pop">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="{DynamicResource Fb.Radius}" Background="#0EA5E9" HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Foreground="White" />
                                </Border>
                                <TextBlock Text="Open…" FontWeight="Bold" FontSize="15" Margin="0,12,0,2" />
                                <TextBlock Text="Open a .flowboard file (Ctrl+O)" Style="{StaticResource Fb.Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Command="{Binding Main.NewProjectInCommand}" h:Behaviors.AnimateIn="pop">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="{DynamicResource Fb.Radius}" Background="#10B981" HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="FolderAdd24" FontSize="20" Foreground="White" />
                                </Border>
                                <TextBlock Text="New in folder…" FontWeight="Bold" FontSize="15" Margin="0,12,0,2" />
                                <TextBlock Text="Choose where the project lives" Style="{StaticResource Fb.Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Command="{Binding Main.NewSampleProjectCommand}" h:Behaviors.AnimateIn="pop">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="{DynamicResource Fb.Radius}" Background="#F59E0B" HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Foreground="White" />
                                </Border>
                                <TextBlock Text="Sample project" FontWeight="Bold" FontSize="15" Margin="0,12,0,2" />
                                <TextBlock Text="A guided board that shows the features" Style="{StaticResource Fb.Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionCard}" Command="{Binding Main.RestoreBackupCommand}" h:Behaviors.AnimateIn="pop">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="{DynamicResource Fb.Radius}" Background="#64748B" HorizontalAlignment="Left">
                                    <ui:SymbolIcon Symbol="ArchiveArrowBack24" FontSize="20" Foreground="White" />
                                </Border>
                                <TextBlock Text="Restore backup…" FontWeight="Bold" FontSize="15" Margin="0,12,0,2" />
                                <TextBlock Text="Open a backup zip as a new project" Style="{StaticResource Fb.Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Border Style="{StaticResource Panel}" Margin="0,8,12,0">
                        <StackPanel>
                            <TextBlock Text="Recent projects" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Projects you open or create show up here." Style="{StaticResource Fb.Muted}"
                                       Visibility="{Binding Projects, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectRow}" Focusable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Project open: stats for every section ============ -->
            <ScrollViewer x:Name="DashScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,16,0,4"
                          Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                <StackPanel x:Name="DashContent">
                    <!-- Greeting -->
                    <StackPanel Margin="4,0,0,18" h:Behaviors.AnimateIn="rise">
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource Fb.GradientTitle}" FontSize="30" />
                        <TextBlock Style="{StaticResource Fb.Muted}" FontSize="14" Margin="0,2,0,0">
                            <Run Text="{Binding DateText, Mode=OneWay}" /> · <Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold" /> · <Run Text="{Binding ProjectSummary, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Sections -->
                    <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SectionCard}">
                                <Border Style="{StaticResource Panel}" Width="262" h:Behaviors.AnimateIn="pop">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="{DynamicResource Fb.Radius}" Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource SymbolName}}" FontSize="18" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Fb.Caption}" />
                                                <TextBlock FontSize="13" Foreground="{DynamicResource Fb.MutedTextBrush}">
                                                    <Run Text="{Binding Count, Mode=OneWay}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Fb.TextBrush}" />
                                                    <Run Text="{Binding CountLabel, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Fb.IconButton}" Width="30" Height="30" VerticalAlignment="Top" ToolTip="{Binding NewText}"
                                                    Command="{Binding DataContext.RunSectionCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="15" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StatLine}">
                                                    <Grid Margin="0,2">
                                                        <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                                        <TextBlock Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Style="{StaticResource Fb.ThinProgress}" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                         Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Fb.Muted}" FontSize="11.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Cards" Style="{StaticResource PanelTitle}" Margin="4,6,0,10"
                               Visibility="{Binding HasCardStats, Converter={StaticResource BoolToVis}}" />
                    <!-- Tiles -->
                    <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False"
                                  Visibility="{Binding HasCardStats, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatTile}">
                                <Border Style="{StaticResource Panel}" Width="212" h:Behaviors.AnimateIn="pop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Fb.Caption}" />
                                            <TextBlock Text="{Binding Value}" FontSize="32" FontWeight="ExtraBold" Foreground="{DynamicResource Fb.TextBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Fb.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="{DynamicResource Fb.Radius}" VerticalAlignment="Top"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}" Opacity="0.9">
                                            <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource SymbolName}}" FontSize="18" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
    
                        <StackPanel Visibility="{Binding HasCardStats, Converter={StaticResource BoolToVis}}">
                            <!-- Completed per day -->
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Completed per day" Style="{StaticResource PanelTitle}" />
                                        <TextBlock Text="{Binding ChartSummary}" Style="{StaticResource Fb.Muted}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Height="170">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- y axis: max and zero -->
                                        <Grid Margin="0,0,8,20">
                                            <TextBlock Text="{Binding ChartMax}" Style="{StaticResource Fb.Muted}" FontSize="11" VerticalAlignment="Top" />
                                            <TextBlock Text="0" Style="{StaticResource Fb.Muted}" FontSize="11" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource Fb.DividerBrush}" Margin="0,7,0,0" />
                                            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Fb.DividerBrush}" Margin="0,0,0,20" />
                                            <ItemsControl ItemsSource="{Binding Bars}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ChartBar}">
                                                        <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="20" />
                                                            </Grid.RowDefinitions>
                                                            <Border x:Name="Bar" VerticalAlignment="Bottom" Margin="3,0" MinHeight="3" CornerRadius="4,4,1,1"
                                                                    Height="{Binding Height, Converter={StaticResource Multiply}, ConverterParameter=140}"
                                                                    Background="{DynamicResource Fb.AccentGradientBrush}" Opacity="0.75" h:Behaviors.AnimateIn="rise" />
                                                            <TextBlock x:Name="Day" Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="11"
                                                                       Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                                                <Setter TargetName="Day" Property="FontWeight" Value="Bold" />
                                                                <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Value}" Value="0">
                                                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Fb.SubtleHoverBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
    
                            <!-- Up next -->
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Up next — overdue and the next 7 days" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Nothing due this week. Enjoy the calm." Style="{StaticResource Fb.Muted}"
                                               Visibility="{Binding Agenda, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                                    <ItemsControl ItemsSource="{Binding Agenda}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type services:AgendaEntry}">
                                                <Button Style="{StaticResource Fb.GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,1"
                                                        Command="{Binding DataContext.OpenAgendaCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="4" Height="28" CornerRadius="2" Margin="0,0,10,0" Background="{Binding Card.Priority, Converter={StaticResource PriorityToBrush}}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Card.Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                                            <TextBlock Style="{StaticResource Fb.Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Board.Name, Mode=OneWay}" /> › <Run Text="{Binding List.Name, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Style="{StaticResource Fb.Badge}" Background="{Binding Card.DueState, Converter={StaticResource DueStateToBrush}}">
                                                            <TextBlock Text="{Binding Card.DueDate, Converter={StaticResource DateText}}" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding Card.DueState, Converter={StaticResource DueStateToForeground}}" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
    
                        <Border Style="{StaticResource Panel}" VerticalAlignment="Top"
                                Visibility="{Binding HasCardStats, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="Due dates, completions and time" Style="{StaticResource PanelTitle}" />
                                <TextBlock Style="{StaticResource Fb.Muted}" TextWrapping="Wrap"
                                           Text="Add a board to track cards: what's due this week, what got done each day, and where your focus time went will show up here." />
                                <Button Style="{StaticResource Fb.AccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="New board" Command="{Binding Main.NewBoardCommand}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <!-- Open cards by priority -->
                            <Border Style="{StaticResource Panel}" Visibility="{Binding HasCardStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Open cards by priority" Style="{StaticResource PanelTitle}" />
                                    <ItemsControl ItemsSource="{Binding Priorities}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PrioritySlice}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Fb.MutedTextBrush}" VerticalAlignment="Center" />
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource Fb.ThinProgress}" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                                                 Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
    
                            <!-- Time per board -->
                            <Border Style="{StaticResource Panel}" Visibility="{Binding HasCardStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Where your time went (7 days)" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Start a timer or a focus session on a card to see time here." Style="{StaticResource Fb.Muted}" TextWrapping="Wrap"
                                               Visibility="{Binding TimeRows, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                                    <ItemsControl ItemsSource="{Binding TimeRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MeterRow}">
                                                <StackPanel Margin="0,4">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                                                        <TextBlock Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar Style="{StaticResource Fb.ThinProgress}" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="0,4,0,0"
                                                                 Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
    
                            <!-- Jump back in -->
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Jump back in" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="Nothing here yet — use + on a section above." Style="{StaticResource Fb.Muted}" TextWrapping="Wrap"
                                               Visibility="{Binding Recent, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                                    <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RecentItem}">
                                                <Button Style="{StaticResource Fb.GhostButton}" HorizontalContentAlignment="Stretch" Padding="6,5" Margin="0,1"
                                                        Command="{Binding DataContext.OpenRecentCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.SubtleBrush}" Margin="0,0,10,0">
                                                            <ui:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource SymbolName}}" FontSize="15" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Fb.Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Switch project -->
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Projects" Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="New project" Command="{Binding Main.NewProjectCommand}">
                                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource Fb.IconButton}" Width="28" Height="28" ToolTip="Open project (Ctrl+O)" Command="{Binding Main.OpenProjectCommand}">
                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectRow}" Focusable="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
