<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:FlowBoard.ViewModels"
                    xmlns:views="clr-namespace:FlowBoard.Views"
                    xmlns:h="clr-namespace:FlowBoard.Helpers">

    <!-- Larger dialogs live in their own views -->
    <DataTemplate DataType="{x:Type vm:CardDetailViewModel}">
        <views:CardDetailView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BoardSettingsViewModel}">
        <views:BoardSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NewBoardViewModel}">
        <views:NewBoardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CommandPaletteViewModel}">
        <views:CommandPaletteView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ArchiveViewModel}">
        <views:ArchiveView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SketchPadViewModel}">
        <views:SketchPadView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AnimaticViewModel}">
        <views:AnimaticView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImageCropViewModel}">
        <views:ImageCropView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LinkPickerViewModel}">
        <views:LinkPickerView />
    </DataTemplate>

    <!-- Documents shown in the main area -->
    <DataTemplate DataType="{x:Type vm:StoryboardViewModel}">
        <views:StoryboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CanvasViewModel}">
        <views:CanvasView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NoteViewModel}">
        <views:NoteView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>

    <!-- Confirm -->
    <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
        <Border Style="{StaticResource Fb.Dialog}" Width="440" Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Fb.DialogTitle}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Fb.Text}" Foreground="{DynamicResource Fb.MutedTextBrush}" Margin="0,10,0,22" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Fb.SubtleButton}" Content="{Binding CancelText}" Command="{Binding CloseCommand}" Margin="0,0,8,0" />
                    <Button x:Name="Ok" Style="{StaticResource Fb.AccentButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                            h:Behaviors.FocusOnLoad="True" IsDefault="True" />
                    <Button x:Name="Danger" Style="{StaticResource Fb.DangerButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                            Visibility="Collapsed" h:Behaviors.FocusOnLoad="True" />
                </StackPanel>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Ok" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Danger" Property="Visibility" Value="Visible" />
                <Setter TargetName="Danger" Property="IsDefault" Value="True" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Text prompt -->
    <DataTemplate DataType="{x:Type vm:TextPromptViewModel}">
        <Border Style="{StaticResource Fb.Dialog}" Width="460" Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Fb.DialogTitle}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Fb.Muted}" FontSize="13" Margin="0,6,0,14"
                           Visibility="{Binding Message, Converter={StaticResource HasValueToVis}}" />
                <ui:TextBox PlaceholderText="{Binding Placeholder}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,20"
                            h:Behaviors.FocusOnLoad="True" h:Behaviors.SelectAllOnFocus="True"
                            h:Behaviors.EnterCommand="{Binding ConfirmCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Fb.SubtleButton}" Content="Cancel" Command="{Binding CloseCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Fb.AccentButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Keyboard shortcuts -->
    <DataTemplate DataType="{x:Type vm:ShortcutsViewModel}">
        <Border Style="{StaticResource Fb.Dialog}" Width="720" Margin="0,24" Padding="24,20,12,20">
            <DockPanel MaxHeight="720">
                <Grid DockPanel.Dock="Top" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="22" Foreground="{DynamicResource Fb.AccentBrush}" />
                        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Fb.DialogTitle}" Margin="10,0,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource Fb.IconButton}" HorizontalAlignment="Right" Command="{Binding CloseCommand}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </Button>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Fb.Muted}" Margin="0,10,0,0"
                           Text="Global hotkeys can be changed in Settings → Hotkeys." />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShortcutSection}">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Fb.SectionTitle}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ShortcutRow}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="250" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border HorizontalAlignment="Left" CornerRadius="{DynamicResource Fb.RadiusSmall}" Padding="8,3" Background="{DynamicResource Fb.SubtleHoverBrush}">
                                                        <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Fb.TextBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Action}" Style="{StaticResource Fb.Text}" VerticalAlignment="Center" FontSize="13" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Image preview -->
    <DataTemplate DataType="{x:Type vm:ImagePreviewViewModel}">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="{Binding Attachment.FullPath, Converter={StaticResource ImagePath}, ConverterParameter=2400}" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,0" CornerRadius="{DynamicResource Fb.Radius}" Background="{DynamicResource Fb.ToastBrush}" Padding="14,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Attachment.Name}" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource Fb.GhostButton}" Foreground="White" Content="Open in app"
                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenAttachmentExternallyCommand}" CommandParameter="{Binding Attachment}" />
                    <Button Style="{StaticResource Fb.GhostButton}" Foreground="White" Content="Close" Command="{Binding CloseCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Quick add (global hotkey) -->
    <DataTemplate DataType="{x:Type vm:QuickAddViewModel}">
        <Border Style="{StaticResource Fb.Dialog}" Width="560" VerticalAlignment="Top" Margin="0,80,0,0" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="20" Foreground="{DynamicResource Fb.AccentBrush}" />
                        <TextBlock Text="Quick add" Style="{StaticResource Fb.DialogTitle}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Fb.Muted}" Text="Enter to add · Esc to close" />
                </Grid>
                <ui:TextBox PlaceholderText="What needs doing? e.g. Edit trailer fri 3pm #video !high" FontSize="16" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                            Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                            h:Behaviors.FocusOnLoad="True" h:Behaviors.EnterCommand="{Binding AddCommand}" />
                <TextBlock Margin="4,6,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fb.AccentTextBrush}" TextWrapping="Wrap"
                           Text="{Binding Title, Converter={StaticResource SmartPreview}}"
                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource HasValueToVis}}" />
                <TextBlock Margin="4,4,0,0" FontSize="11" Foreground="{DynamicResource Fb.FaintTextBrush}"
                           Text="Try: Edit trailer fri 3pm #video !high" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Board" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding Board}" DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="List" Style="{StaticResource Fb.Caption}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding List}" DisplayMemberPath="Name" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Due" Style="{StaticResource Fb.Caption}" Margin="0,12,0,4" />
                <WrapPanel>
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaDue" Content="No date" IsChecked="{Binding Due, Converter={StaticResource Equals}, ConverterParameter=none}" />
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaDue" Content="Today" IsChecked="{Binding Due, Converter={StaticResource Equals}, ConverterParameter=today}" />
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaDue" Content="Tomorrow" IsChecked="{Binding Due, Converter={StaticResource Equals}, ConverterParameter=tomorrow}" />
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaDue" Content="In a week" IsChecked="{Binding Due, Converter={StaticResource Equals}, ConverterParameter=nextweek}" />
                </WrapPanel>
                <TextBlock Text="Priority" Style="{StaticResource Fb.Caption}" Margin="0,12,0,4" />
                <WrapPanel>
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaPrio" Content="None" IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=None}" />
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaPrio" Content="Low" IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=Low}" />
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaPrio" Content="Medium" IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=Medium}" />
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaPrio" Content="High" IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=High}" />
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="QaPrio" Content="Urgent" IsChecked="{Binding Priority, Converter={StaticResource Equals}, ConverterParameter=Urgent}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource Fb.SubtleButton}" Content="Cancel" Command="{Binding CloseCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Fb.AccentButton}" Content="Add card" Command="{Binding AddCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
