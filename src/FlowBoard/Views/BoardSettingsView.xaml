<UserControl x:Class="FlowBoard.Views.BoardSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:models="clr-namespace:FlowBoard.Models"
             xmlns:services="clr-namespace:FlowBoard.Services"
             xmlns:views="clr-namespace:FlowBoard.Views"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:BoardSettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SliderRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <!-- Right-hand drawer: the board stays visible so every change previews live. -->
    <Border Style="{StaticResource Fb.Dialog}" Width="400" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,8,8,8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="22,20,16,12">
                <StackPanel>
                    <TextBlock Text="Customize board" Style="{StaticResource Fb.GradientTitle}" FontSize="22" />
                    <TextBlock Text="{Binding Board.Name}" Style="{StaticResource Fb.Muted}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,40,0" />
                </StackPanel>
                <Button Style="{StaticResource Fb.IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip="Close (Esc)">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                </Button>
            </Grid>

            <Border DockPanel.Dock="Top" Style="{StaticResource Fb.SegmentGroup}" Margin="22,0,22,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="BsTab" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=style}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PaintBrush24" FontSize="14" />
                            <TextBlock Text="Style" Margin="6,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Fb.Segment}" GroupName="BsTab" IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=labels}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Tag24" FontSize="14" />
                            <TextBlock Text="Labels" Margin="6,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Grid>
            <!-- Style tab: preview pinned on top, controls scroll inside the editor -->
            <views:BoardStyleEditor Margin="22,0,12,16" Panel.ZIndex="1" Visibility="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=style}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,16,20">
                <Grid>
                    <!-- ============ Labels ============ -->
                    <StackPanel Visibility="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=labels}">
                        <TextBlock Style="{StaticResource Fb.Muted}" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Labels belong to this board. Renaming or recoloring a label updates every card that uses it. Hover a card and press 1–9 to toggle labels." />
                        <ItemsControl ItemsSource="{Binding Board.Labels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Label}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="{DynamicResource Fb.Radius}" Height="34" Padding="14,0" Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                                     FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource ContrastBrush}}"
                                                     CaretBrush="{Binding Color, Converter={StaticResource ContrastBrush}}">
                                                <TextBox.Template>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                    </ControlTemplate>
                                                </TextBox.Template>
                                            </TextBox>
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource Fb.IconButton}" Margin="6,0,0,0" ToolTip="Change color"
                                                Command="{Binding DataContext.EditLabelCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Color24" FontSize="15" />
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource Fb.IconButton}" ToolTip="Delete label"
                                                Command="{Binding DataContext.DeleteLabelCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Fb.Section}" Margin="0,6,0,0" Visibility="{Binding EditingLabel, Converter={StaticResource HasValueToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding EditingLabel.Name, StringFormat='Color for “{0}”'}" Style="{StaticResource Fb.Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding LabelPalette}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Fb.SwatchButton}" Width="36" Height="28" Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    Command="{Binding DataContext.SetLabelColorCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource Fb.AccentButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding AddLabelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                                <TextBlock Text="New label" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
