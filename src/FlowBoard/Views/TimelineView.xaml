<UserControl x:Class="FlowBoard.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FlowBoard.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Border Margin="12,12,12,12" Background="{DynamicResource Fb.ListBrush}" BorderBrush="{DynamicResource Fb.ListBorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource Fb.RadiusLarge}" h:Behaviors.ClipRadius="{DynamicResource Fb.RadiusLargeValue}"
            DataContext="{Binding Timeline}">
        <DockPanel>
            <!-- Toolbar -->
            <Grid DockPanel.Dock="Top" Margin="12,10,12,8">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Fb.SubtleButton}" Padding="12,6" Command="{Binding ScrollToTodayCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CalendarToday24" FontSize="15" />
                            <TextBlock Text="Today" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Fb.SegmentGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Fb.IconButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (more days)">
                                <ui:SymbolIcon Symbol="ZoomOut24" FontSize="15" />
                            </Button>
                            <Button Style="{StaticResource Fb.IconButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in">
                                <ui:SymbolIcon Symbol="ZoomIn24" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Fb.Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap"
                               Text="Drag a bar to move it, drag its edges to change start or due date. Arrows show “blocked by” links." />
                </StackPanel>
                <ToggleButton x:Name="UnscheduledToggle" Style="{StaticResource Fb.HeaderToggle}" HorizontalAlignment="Right"
                              Visibility="{Binding UnscheduledCount, Converter={StaticResource HasValueToVis}}" ToolTip="Cards without dates">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CalendarQuestionMark24" FontSize="15" />
                        <TextBlock Margin="6,0,0,0">
                            <Run Text="{Binding UnscheduledCount, Mode=OneWay}" /> <Run Text="unscheduled" />
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
                <Popup Style="{StaticResource Fb.Popup}" PlacementTarget="{Binding ElementName=UnscheduledToggle}" IsOpen="{Binding IsChecked, ElementName=UnscheduledToggle}"
                       HorizontalOffset="-200">
                    <Border Style="{StaticResource Fb.Flyout}" Width="340" MaxHeight="420" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="No dates yet — schedule to put them on the timeline" Style="{StaticResource Fb.Caption}" Margin="4,0,0,8" TextWrapping="Wrap" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Unscheduled}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineRow}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="4" Height="24" CornerRadius="2" Background="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Style="{StaticResource Fb.GhostButton}" Padding="4" HorizontalContentAlignment="Left"
                                                        Command="{Binding DataContext.Timeline.OpenCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                                        <TextBlock Text="{Binding List.Name}" Style="{StaticResource Fb.Muted}" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource Fb.SubtleButton}" Padding="8,4" Content="Schedule" FontSize="12"
                                                        Command="{Binding DataContext.Timeline.ScheduleCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Empty -->
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="40" Foreground="{DynamicResource Fb.FaintTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing on the timeline yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="Give cards a start or due date (or use Schedule on the top right)." Style="{StaticResource Fb.Muted}" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.ColumnSpan="2" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource Fb.DividerBrush}" />
                    <TextBlock Text="CARD" Style="{StaticResource Fb.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />

                    <!-- Date header -->
                    <ScrollViewer x:Name="HeaderScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Days}" Width="{Binding TotalWidth}" Height="46" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TimelineDay}">
                                    <Grid Width="{Binding Width}" Height="46">
                                        <TextBlock Text="{Binding MonthText}" FontWeight="Bold" FontSize="12" Margin="4,4,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource Fb.TextBrush}" TextWrapping="NoWrap" ClipToBounds="False" />
                                        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Padding="4,1" CornerRadius="{DynamicResource Fb.RadiusSmall}">
                                            <TextBlock x:Name="Num" Text="{Binding DayText}" FontSize="11" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Fb.AccentBrush}" />
                                            <Setter TargetName="Num" Property="Foreground" Value="White" />
                                            <Setter TargetName="Num" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Card names -->
                    <ScrollViewer x:Name="NamesScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  PreviewMouseWheel="OnNamesWheel">
                        <ItemsControl ItemsSource="{Binding Rows}" Height="{Binding TotalHeight}" VerticalAlignment="Top" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TimelineRow}">
                                    <Grid Height="{Binding Height}">
                                        <!-- List header -->
                                        <StackPanel x:Name="Header" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Fb.ListHeaderTextBrush}" />
                                            <TextBlock Text="{Binding Count}" Style="{StaticResource Fb.Muted}" FontSize="12" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <!-- Card -->
                                        <Button x:Name="CardRow" Style="{StaticResource Fb.GhostButton}" Padding="10,2" Margin="6,2" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.Timeline.OpenCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon x:Name="Done" Symbol="CheckmarkCircle24" Filled="True" FontSize="14" Foreground="{DynamicResource Fb.SuccessBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                                                <ui:SymbolIcon x:Name="Blocked" Symbol="LockClosed24" FontSize="13" Foreground="{DynamicResource Fb.WarningBrush}" Margin="0,0,6,0" Visibility="Collapsed"
                                                               ToolTip="Blocked by an unfinished card" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                                    <TextBlock Text="{Binding DatesText}" FontSize="11" Style="{StaticResource Fb.Muted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="Header" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="CardRow" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Card.IsCompleted}" Value="True">
                                            <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter TargetName="Blocked" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chart -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <ScrollViewer x:Name="ChartScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnChartScroll" PreviewMouseWheel="OnChartWheel">
                            <Grid x:Name="Chart" Width="{Binding TotalWidth}" Height="{Binding TotalHeight}" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                                  MouseLeftButtonDown="OnChartDown" MouseMove="OnChartMove" MouseLeftButtonUp="OnChartUp">
                                <!-- Weekend columns + today line -->
                                <ItemsControl ItemsSource="{Binding Days}" Focusable="False" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineDay}">
                                            <Border x:Name="Col" Width="{Binding Width}" Height="{Binding DataContext.TotalHeight, ElementName=Chart}" BorderThickness="1,0,0,0"
                                                    BorderBrush="Transparent" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                    <Setter TargetName="Col" Property="Background" Value="{DynamicResource Fb.SurfaceAltBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Date.DayOfWeek}" Value="Monday">
                                                    <Setter TargetName="Col" Property="BorderBrush" Value="{DynamicResource Fb.DividerBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Canvas IsHitTestVisible="False">
                                    <Rectangle Canvas.Left="{Binding TodayX}" Width="2" Height="{Binding TotalHeight}" Fill="{DynamicResource Fb.AccentBrush}" Opacity="0.85" />
                                </Canvas>
    
                                <!-- Dependency arrows -->
                                <ItemsControl ItemsSource="{Binding Links}" Focusable="False" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineLink}">
                                            <Canvas>
                                                <Path x:Name="Line" Data="{Binding Path, Converter={StaticResource Geometry}}" Stroke="{DynamicResource Fb.MutedTextBrush}" StrokeThickness="1.6" />
                                                <Path x:Name="Head" Data="{Binding Arrow, Converter={StaticResource Geometry}}" Fill="{DynamicResource Fb.MutedTextBrush}" />
                                            </Canvas>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                                                    <Setter TargetName="Line" Property="Stroke" Value="{DynamicResource Fb.DangerBrush}" />
                                                    <Setter TargetName="Head" Property="Fill" Value="{DynamicResource Fb.DangerBrush}" />
                                                    <Setter TargetName="Line" Property="StrokeDashArray" Value="3 2" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
    
                                <!-- Bars -->
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineRow}">
                                            <Grid x:Name="Bar" Width="{Binding Width}" Height="{Binding Height}" Visibility="Collapsed">
                                                <Border x:Name="Body" Tag="move" Margin="0,7" CornerRadius="{DynamicResource Fb.Radius}" Cursor="SizeWE"
                                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" ToolTip="{Binding DatesText}"
                                                        Effect="{StaticResource Fb.CardShadow}">
                                                    <TextBlock Text="{Binding Title}" Foreground="{Binding Color, Converter={StaticResource ContrastBrush}}" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                                </Border>
                                                <Border Tag="start" Width="8" HorizontalAlignment="Left" Margin="0,7" Background="Transparent" Cursor="SizeWE" ToolTip="Drag to change the start date" />
                                                <Border Tag="end" Width="8" HorizontalAlignment="Right" Margin="0,7" Background="Transparent" Cursor="SizeWE" ToolTip="Drag to change the due date" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasBar}" Value="True">
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Card.IsCompleted}" Value="True">
                                                    <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                        <c:ScrollMinimap Target="{Binding ElementName=ChartScroller}" />
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
