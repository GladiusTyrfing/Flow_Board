<UserControl x:Class="FlowBoard.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:FlowBoard.ViewModels"
             xmlns:h="clr-namespace:FlowBoard.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CommandPaletteViewModel}">
    <Border Style="{StaticResource Fb.Dialog}" Width="640" VerticalAlignment="Top" Margin="0,70,0,0" Padding="0">
        <DockPanel MaxHeight="520">
            <Grid DockPanel.Dock="Top" Margin="16,12">
                <ui:SymbolIcon Symbol="Search24" FontSize="20" HorizontalAlignment="Left" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                <TextBox x:Name="QueryBox" Margin="30,0,0,0" FontSize="17" BorderThickness="0" Background="Transparent" Padding="0,4"
                         Foreground="{DynamicResource Fb.TextBrush}" CaretBrush="{DynamicResource Fb.TextBrush}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="QueryBox_PreviewKeyDown"
                         h:Behaviors.FocusOnLoad="True">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="Type to search cards, boards and commands…" Foreground="{DynamicResource Fb.FaintTextBrush}"
                                           Visibility="Collapsed" Margin="{TemplateBinding Padding}" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Fb.DividerBrush}" />
            <Grid DockPanel.Dock="Bottom" Margin="16,8">
                <TextBlock Style="{StaticResource Fb.Muted}" Text="↑ ↓ to navigate · Enter to open · Esc to close" />
            </Grid>
            <ListBox x:Name="Results" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                     Margin="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="Results_MouseLeftButtonUp"
                     SelectionChanged="Results_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PaletteItem}">
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Fb.SubtleBrush}" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Foreground="{DynamicResource Fb.TextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fb.TextBrush}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Fb.Muted}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Subtitle, Converter={StaticResource HasValueToVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="{DynamicResource Fb.SubtleHoverBrush}"
                                        Visibility="{Binding Shortcut, Converter={StaticResource HasValueToVis}}">
                                    <TextBlock Text="{Binding Shortcut}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource Fb.MutedTextBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Group}" Style="{StaticResource Fb.Caption}" Margin="10,0,4,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
