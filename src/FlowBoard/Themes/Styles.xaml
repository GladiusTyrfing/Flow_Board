<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:FlowBoard.Converters">

    <!-- ============ Converters ============ -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:HasValueToVisibilityConverter x:Key="HasValueToVis" />
    <conv:EqualsConverter x:Key="Equals" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:HexToColorConverter x:Key="HexToColor" />
    <conv:ContrastBrushConverter x:Key="ContrastBrush" />
    <conv:BoardBackgroundConverter x:Key="BoardBackground" />
    <conv:BoardThumbnailConverter x:Key="BoardThumbnail" />
    <conv:ImagePathConverter x:Key="ImagePath" />
    <conv:DueStateToBrushConverter x:Key="DueStateToBrush" />
    <conv:DueStateToForegroundConverter x:Key="DueStateToForeground" />
    <conv:PriorityToBrushConverter x:Key="PriorityToBrush" />
    <conv:PriorityToTextConverter x:Key="PriorityToText" />
    <conv:InitialsConverter x:Key="Initials" />
    <conv:RelativeTimeConverter x:Key="RelativeTime" />
    <conv:StringToSymbolConverter x:Key="StringToSymbol" />
    <conv:AttachmentIconConverter x:Key="AttachmentIcon" />
    <conv:MultiplyConverter x:Key="Multiply" />
    <conv:DateOnlyTextConverter x:Key="DateText" />
    <conv:ArrayMultiConverter x:Key="ToArray" />
    <conv:SameMultiConverter x:Key="Same" />
    <conv:IntToDoubleConverter x:Key="IntToDouble" />

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

    <DropShadowEffect x:Key="Fb.CardShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.25"
                      Color="Black" />
    <DropShadowEffect x:Key="Fb.PopupShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35"
                      Color="Black" />

    <!-- ============ Text ============ -->
    <Style x:Key="Fb.Text" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Fb.Muted" TargetType="TextBlock" BasedOn="{StaticResource Fb.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Fb.MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Fb.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Fb.Text}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Fb.DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource Fb.Text}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Fb.Caption" TargetType="TextBlock" BasedOn="{StaticResource Fb.Text}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Fb.MutedTextBrush}" />
    </Style>

    <!-- ============ Buttons ============ -->
    <!-- A soft hover layer that fades in: used by every custom button for a fluid feel. -->
    <ControlTemplate x:Key="Fb.ButtonTemplate" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" />
            <Border x:Name="Hover" Background="{DynamicResource Fb.SubtleHoverBrush}" Opacity="0"
                    CornerRadius="6" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Fb.SubtlePressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Fb.GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Fb.ButtonTemplate}" />
    </Style>

    <Style x:Key="Fb.SubtleButton" TargetType="Button" BasedOn="{StaticResource Fb.GhostButton}">
        <Setter Property="Background" Value="{DynamicResource Fb.SubtleBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Fb.AccentButton" TargetType="Button" BasedOn="{StaticResource Fb.GhostButton}">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="Fb.DangerButton" TargetType="Button" BasedOn="{StaticResource Fb.GhostButton}">
        <Setter Property="Background" Value="{DynamicResource Fb.DangerStrongBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="Fb.IconButton" TargetType="Button" BasedOn="{StaticResource Fb.GhostButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Fb.MutedTextBrush}" />
    </Style>

    <!-- White-on-image buttons in the board header -->
    <Style x:Key="Fb.HeaderButton" TargetType="Button" BasedOn="{StaticResource Fb.GhostButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Fb.HeaderToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template" Value="{StaticResource Fb.ButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#40FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Color swatch: Background carries the color; shows a ring on hover / when Tag="selected" -->
    <Style x:Key="Fb.SwatchButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Margin="-3" />
                        <Border CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Fb.MutedTextBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control item (view switcher, theme picker) -->
    <Style x:Key="Fb.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="Sel" CornerRadius="6" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                        <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fb.SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round "complete" checkbox like Trello -->
    <Style x:Key="Fb.RoundCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Fb.MutedTextBrush}" StrokeThickness="1.5" />
                        <Ellipse x:Name="Fill" Fill="{DynamicResource Fb.SuccessBrush}" Opacity="0" />
                        <Path x:Name="Tick" Data="M 4.5,9.2 L 7.6,12.2 L 13.5,5.8" Stroke="{DynamicResource Fb.OnStatusBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" Stretch="None" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Fb.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Fb.SuccessBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Text boxes ============ -->
    <!-- Looks like plain text until focused (inline editing of titles and names). -->
    <Style x:Key="Fb.InlineTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Fb.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Fb.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.SubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.InputBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bordered input with rounded corners. -->
    <Style x:Key="Fb.Input" TargetType="TextBox" BasedOn="{StaticResource Fb.InlineTextBox}">
        <Setter Property="Background" Value="{DynamicResource Fb.InputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fb.InputBorderBrush}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- ============ Surfaces ============ -->
    <Style x:Key="Fb.Flyout" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fb.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fb.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="12,4,12,20" />
        <Setter Property="Effect" Value="{StaticResource Fb.PopupShadow}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fb.TextBrush}" />
    </Style>

    <Style x:Key="Fb.Dialog" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fb.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fb.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect" Value="{StaticResource Fb.PopupShadow}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fb.TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Fb.Section" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fb.SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Fb.Popup" TargetType="Popup">
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="StaysOpen" Value="False" />
        <Setter Property="PopupAnimation" Value="Fade" />
        <Setter Property="Placement" Value="Bottom" />
    </Style>

    <Style x:Key="Fb.ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="3" Background="{DynamicResource Fb.SubtleHoverBrush}" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiny rounded pill used for badges -->
    <Style x:Key="Fb.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="Margin" Value="0,4,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Fb.MenuIcon" TargetType="FrameworkElement">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
</ResourceDictionary>
